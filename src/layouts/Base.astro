---
import { SITE } from '../site.config';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = SITE.title, description = SITE.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL('/avatar.jpg', SITE.url).href;
const nav = [
  { label: '笔记', href: '/notes/', icon: '<path d="M12 6.5C10.5 5 8.5 4.5 4 4.5v14c4.5 0 6.5.5 8 2 1.5-1.5 3.5-2 8-2v-14c-4.5 0-6.5.5-8 2Z"/><path d="M12 6.5v14"/>' },
  { label: '项目', href: '/projects/', icon: '<path d="m8 8-4.5 4L8 16M16 8l4.5 4L16 16M13 5l-2.5 14"/>' },
  { label: '关于', href: '/about/', icon: '<circle cx="12" cy="8" r="3.6"/><path d="M5 19.5c1.2-3.2 3.9-4.8 7-4.8s5.8 1.6 7 4.8"/>' },
  { label: '联系', href: '/about/#contact', icon: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/>' },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%232a160d'/><text x='50' y='68' font-size='52' text-anchor='middle' fill='%23fcfcf8' font-family='Georgia'>K</text></svg>" />
  </head>
  <body id="top">
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          <svg class="brand-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="5"/><path d="M4.5 15.5c-1.2-2.2 3.2-6.6 8.8-9.2 5-2.3 9.6-2.4 10.4-.6.4 1-.2 2.4-1.5 4"/><circle cx="16.5" cy="7.5" r="0.9" fill="currentColor" stroke="none"/></svg>
          <span>{SITE.name}</span>
        </a>
        <nav class="site-nav" aria-label="主导航">
          {nav.map((item) => (
            <a class="nav-pill" href={item.href}>
              <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon}></svg>
              <span>{item.label}</span>
            </a>
          ))}
        </nav>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <span>© {SITE.since} {SITE.name}</span>
        <span>v1.0.0 — built with Astro</span>
        <span class="footer-right">
          <a class="footer-icon-link" href={`mailto:${SITE.email}`} aria-label="发送邮件">
            <svg class="footer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
            <span>{SITE.email}</span>
          </a>
          <a class="footer-icon-link" href={SITE.github} target="_blank" rel="noopener" aria-label="GitHub 主页">
            <svg class="footer-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.55v-1.93c-3.2.7-3.87-1.54-3.87-1.54-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.35.96.1-.75.4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.9 10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.73.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25 5.67.41.36.77 1.05.77 2.13v3.16c0 .3.21.67.8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"/></svg>
            <span>GitHub</span>
          </a>
          <a class="back-top" href="#top" aria-label="回到顶部">
            <svg class="footer-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6"/></svg>
            <span>回到顶部</span>
          </a>
        </span>
      </div>
    </footer>
  </body>
</html>
