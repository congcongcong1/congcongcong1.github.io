---
// 按项目语言渲染极简线条小图标；未知语言回退为圆点
interface Props {
  lang: string;
}
const { lang } = Astro.props;
const key = lang.toLowerCase();
const icons: Record<string, string> = {
  // 终端 >_
  shell: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 3 3-3 3M12 15h5"/>',
  // Python：两个相扣的圆角块
  python: '<path d="M12 3H8a3 3 0 0 0-3 3v3h5a2 2 0 0 1 2 2v1H8a3 3 0 0 0-3 3v1a3 3 0 0 0 3 3h4v-3a2 2 0 0 1 2-2h2a3 3 0 0 0 3-3V6a3 3 0 0 0-3-3h-4Z"/><circle cx="8.5" cy="6.5" r="0.4" fill="currentColor"/><circle cx="15.5" cy="17.5" r="0.4" fill="currentColor"/>',
  // Astro：带环行星
  astro: '<circle cx="12" cy="12" r="5"/><path d="M4.5 15.5c-1.2-2.2 3.2-6.6 8.8-9.2 5-2.3 9.6-2.4 10.4-.6.4 1-.2 2.4-1.5 4"/><circle cx="16.5" cy="7.5" r="0.9" fill="currentColor" stroke="none"/>',
  // TeX：西格玛
  tex: '<path d="M7 5h10l-6 7 6 7H7"/>',
  // C++：花括号与加号
  'c++': '<path d="M9 4c-2 0-2.5 1-2.5 2.5V10c0 1.5-1 2.5-2.5 2.5 1.5 0 2.5 1 2.5 2.5v3.5C6.5 19 7 20 9 20M15 4c2 0 2.5 1 2.5 2.5V10c0 1.5 1 2.5 2.5 2.5-1.5 0-2.5 1-2.5 2.5v3.5c0 1.5-.5 2.5-2.5 2.5"/><path d="M11 9.5v5M8.75 12h4.5"/>',
};
const path = icons[key] ?? '<circle cx="12" cy="12" r="4"/>';
---

<svg class="lang-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={path}></svg>
