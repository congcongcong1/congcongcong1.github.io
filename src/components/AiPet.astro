---
// 「小聪」— Kaiser 的 AI 数字分身：悬浮在主页角落的小生物，点击打开对话面板。
// 形象：手绘感 SVG 团状小生物（层叠有机形体 + 平面填色），眼睛跟随光标、随机眨眼，
// 待机时轻轻漂浮；对话时嘴巴开合。
// 模式：data-endpoint 为空走本地离线人格；接入 Worker 后走 Kimi 真身。
import { SITE } from '../site.config';
---

<div class="aipet" id="aipet" data-endpoint={SITE.aiEndpoint} data-name={SITE.name}>
  <!-- ============ 悬浮小生物 ============ -->
  <button class="aipet-face" id="aipet-face" type="button" aria-label="叫醒小聪，和它聊聊" aria-expanded="false">
    <svg viewBox="0 0 120 120" aria-hidden="true">
      <defs>
        <radialGradient id="aipet-blush" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#e8927c" stop-opacity="0.55" />
          <stop offset="100%" stop-color="#e8927c" stop-opacity="0" />
        </radialGradient>
      </defs>
      <!-- 环绕小星星 -->
      <g class="aipet-orbits">
        <path class="aipet-star s1" d="M14 30l1.8 4.2L20 36l-4.2 1.8L14 42l-1.8-4.2L8 36l4.2-1.8Z" />
        <path class="aipet-star s2" d="M104 20l1.4 3.2 3.2 1.4-3.2 1.4-1.4 3.2-1.4-3.2-3.2-1.4 3.2-1.4Z" />
        <circle class="aipet-star s3" cx="108" cy="88" r="2.2" />
      </g>
      <!-- 身体：手绘感团状轮廓（双层描边制造笨拙的呼吸感） -->
      <g class="aipet-body-g">
        <path class="aipet-body-shadow" d="M60 16c8 0 12 5 17 6s10-2 15 3 3 10 6 15 8 6 7 13-6 8-7 14 2 10-3 14-11 0-17 3-8 7-16 7-11-5-17-6-11 2-16-3-2-10-5-15-8-7-7-14 7-8 8-14-3-10 2-14 11 1 17-2 8-7 16-7Z" />
        <path class="aipet-body" d="M60 20c7 0 11 4 15 5s9-2 13 3 3 9 5 13 7 5 6 11-5 7-6 13 2 9-3 12-10 0-15 3-7 6-14 6-10-4-15-5-10 2-14-3-2-9-4-13-7-6-6-12 6-7 7-12-2-9 2-12 10 1 15-2 7-6 14-6Z" />
        <!-- 呆毛 -->
        <path class="aipet-hair" d="M58 21c-1-6 1-10 5-13" fill="none" stroke-linecap="round" />
        <!-- 眼睛（整组眨眼缩放） -->
        <g class="aipet-eyes" id="aipet-eyes">
          <g class="aipet-eye" data-eye>
            <ellipse class="eye-white" cx="45" cy="55" rx="9.5" ry="10.5" />
            <g class="eye-pupil"><circle cx="46.5" cy="57" r="4.6" /><circle class="eye-glint" cx="48.3" cy="54.8" r="1.5" /></g>
          </g>
          <g class="aipet-eye" data-eye>
            <ellipse class="eye-white" cx="75" cy="55" rx="9.5" ry="10.5" />
            <g class="eye-pupil"><circle cx="76.5" cy="57" r="4.6" /><circle class="eye-glint" cx="78.3" cy="54.8" r="1.5" /></g>
          </g>
        </g>
        <!-- 腮红 -->
        <ellipse cx="34" cy="68" rx="7" ry="4.5" fill="url(#aipet-blush)" />
        <ellipse cx="86" cy="68" rx="7" ry="4.5" fill="url(#aipet-blush)" />
        <!-- 嘴巴：待机弧线 / 说话圆嘴，切换透明度 -->
        <path class="aipet-mouth mouth-idle" d="M54 72q6 5 12 0" fill="none" stroke-linecap="round" />
        <ellipse class="aipet-mouth mouth-talk" cx="60" cy="74" rx="4" ry="5" style="opacity:0" />
      </g>
    </svg>
    <span class="aipet-tag mono-meta">小聪</span>
  </button>
  <span class="aipet-mood" id="aipet-mood" hidden></span>

  <!-- ============ 对话面板 ============ -->
  <section class="aipet-panel" id="aipet-panel" role="dialog" aria-modal="false" aria-label="和小聪对话" hidden>
    <header class="aipet-head">
      <span class="aipet-mini" aria-hidden="true">
        <svg viewBox="0 0 120 120">
          <path class="aipet-body" d="M60 20c7 0 11 4 15 5s9-2 13 3 3 9 5 13 7 5 6 11-5 7-6 13 2 9-3 12-10 0-15 3-7 6-14 6-10-4-15-5-10 2-14-3-2-9-4-13-7-6-6-12 6-7 7-12-2-9 2-12 10 1 15-2 7-6 14-6Z" />
          <g class="aipet-eyes-mini">
            <circle class="mini-pupil" cx="46" cy="56" r="4.4" /><circle class="mini-pupil" cx="74" cy="56" r="4.4" />
          </g>
          <path d="M55 71q5 4 10 0" fill="none" stroke-linecap="round" class="mini-mouth" />
        </svg>
      </span>
      <span class="aipet-title">
        <strong>小聪</strong>
        <em class="mono-meta" id="aipet-status">数字分身 · 离线中</em>
      </span>
      <button class="aipet-clear" id="aipet-clear" type="button" aria-label="清空本机对话" title="清空本机对话">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 7h16M10 4h4M7 7l1 13h8l1-13M10 11v6M14 11v6"/></svg>
      </button>
      <button class="aipet-expand" id="aipet-expand" type="button" aria-label="全屏对话" title="全屏对话" aria-pressed="false">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <g class="icon-expand"><path d="M9 3H3v6M15 3h6v6M9 21H3v-6M15 21h6v-6"/></g>
          <g class="icon-compress" style="display:none"><path d="M3 9h6V3M21 9h-6V3M3 15h6v6M21 15h-6v6"/></g>
        </svg>
      </button>
      <button class="aipet-close" id="aipet-close" type="button" aria-label="收起对话">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 9l6 6 6-6"/></svg>
      </button>
    </header>
    <div class="aipet-scope" id="aipet-scope" hidden><span id="aipet-scope-label"></span><button id="aipet-scope-exit" type="button">退出本页</button></div>
    <div class="aipet-msgs" id="aipet-msgs" aria-live="polite"></div>
    <div class="aipet-chips" id="aipet-chips"></div>
    <p class="aipet-privacy">本机保存历史；在线消息和图片发给 Kimi，站点可能记录问答与 IP。清空仅删除本机记录。</p>
    <div class="aipet-attach" id="aipet-attach" hidden></div>
    <form class="aipet-form" id="aipet-form">
      <input type="file" id="aipet-file" multiple hidden
        accept="image/*,.pdf,.txt,.md,.markdown,.json,.js,.ts,.tsx,.jsx,.py,.csv,.log,.xml,.html,.css,.yml,.yaml,.toml,.ini,.sh,.c,.h,.cpp,.hpp,.java,.go,.rs,.sql,.vue,.astro" />
      <button class="aipet-attach-btn" id="aipet-attach-btn" type="button" aria-label="添加图片或文件" title="添加图片或文件">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
      </button>
      <input class="aipet-input" id="aipet-input" type="text" autocomplete="off" maxlength="2000"
        placeholder="和小聪说点什么…（可直接粘贴截图）" aria-label="输入消息" />
      <button class="aipet-send" type="submit" aria-label="发送">
        <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19V5M6 11l6-6 6 6"/></svg>
      </button>
    </form>
  </section>
</div>

<style is:global>
  /* ---------- 悬浮小生物 ---------- */
/* 注意：根元素是 <div class="aipet" id="aipet">（id 和 class 在同一元素上），
     容器自身规则必须只写 #aipet，写 #aipet .aipet 选不中（元素不是自己的后代） */
#aipet{ position: fixed; right: clamp(0.9rem, 3vw, 2.2rem); bottom: clamp(0.9rem, 3vw, 2.2rem); z-index: 60; }
  #aipet .aipet-face {
    display: block; width: 86px; height: 86px; padding: 0;
    background: none; border: 0; cursor: pointer; position: relative;
    filter: drop-shadow(0 6px 18px rgba(42, 22, 13, 0.18));
    transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
    -webkit-tap-highlight-color: transparent;
  }
#aipet .aipet-face:hover{ transform: scale(1.07); }
#aipet .aipet-face svg{ width: 100%; height: 100%; overflow: visible; display: block; }
#aipet .aipet-body-g{ animation: aipet-bob 4.6s ease-in-out infinite; transform-origin: 60px 66px; }
  @keyframes aipet-bob {
    0%, 100% { transform: translateY(0) rotate(-2deg); }
    50%      { transform: translateY(-7px) rotate(2.4deg); }
  }
#aipet .aipet-body-shadow{ fill: var(--ink); opacity: 0.12; transform: translate(2.5px, 4px); }
#aipet .aipet-body{ fill: var(--paper); stroke: var(--ink); stroke-width: 3.4; stroke-linejoin: round; }
#aipet .aipet-hair{ stroke: var(--ink); stroke-width: 3.2; }
#aipet .eye-white{ fill: var(--paper); stroke: var(--ink); stroke-width: 3; }
#aipet .eye-pupil circle:first-child{ fill: var(--ink); }
#aipet .eye-glint{ fill: var(--paper); }
#aipet .aipet-eyes{ transform-origin: 60px 55px; transform-box: view-box; }
#aipet.blinking .aipet-eyes{ animation: aipet-blink 0.22s ease-in-out; }
  @keyframes aipet-blink { 50% { transform: scaleY(0.08); } }
#aipet .aipet-eyes,#aipet .eye-pupil{ transition: transform 0.12s ease-out; }
#aipet .aipet-mouth{ stroke: var(--ink); stroke-width: 3; fill: var(--ink); }
#aipet .mouth-talk{ stroke: none; }
#aipet.talking .mouth-idle{ opacity: 0; }
#aipet.talking .mouth-talk{ opacity: 1 !important; animation: aipet-chatter 0.32s ease-in-out infinite; }
  @keyframes aipet-chatter { 50% { transform: scaleY(0.45); } }
#aipet .aipet-orbits .aipet-star{ fill: var(--marker, #eebe7a); transform-origin: center; transform-box: fill-box; }
#aipet .s1{ animation: aipet-twinkle 2.8s ease-in-out infinite; }
#aipet .s2{ animation: aipet-twinkle 3.6s ease-in-out 0.8s infinite; }
#aipet .s3{ animation: aipet-twinkle 3.1s ease-in-out 1.5s infinite; }
  @keyframes aipet-twinkle { 50% { transform: scale(0.4) rotate(40deg); opacity: 0.35; } }
#aipet .aipet-tag{
    position: absolute; top: -4px; right: -6px;
    background: var(--ink); color: var(--paper);
    font-size: 0.62rem; letter-spacing: 0.14em; padding: 0.15em 0.55em;
    border-radius: 99px; transform: rotate(6deg);
  }

  /* ---------- 「此刻」签名档：气泡挂在脸上方，轮换签名 ---------- */
  #aipet .aipet-mood{
    position: absolute; right: 6px; bottom: 96px; z-index: 61;
    max-width: 210px; padding: 0.32em 0.7em; border-radius: 12px;
    background: var(--paper); color: var(--ink);
    border: 1.5px solid var(--ink-20); box-shadow: 0 8px 22px rgba(42, 22, 13, 0.18);
    font-size: 0.72rem; line-height: 1.4; white-space: nowrap;
    animation: aipet-mood-in 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes aipet-mood-in { from { opacity: 0; transform: translateY(6px) scale(0.85); } }
  #aipet .aipet-mood::after{
    content: ''; position: absolute; right: 18px; bottom: -5.5px; width: 9px; height: 9px;
    background: var(--paper); border-right: 1.5px solid var(--ink-20); border-bottom: 1.5px solid var(--ink-20);
    transform: rotate(45deg);
  }
  body.night #aipet .aipet-mood{ background: #332216; color: #f7ead9; border-color: rgba(238, 190, 122, 0.35); }
  body.night #aipet .aipet-mood::after{ background: #332216; border-color: rgba(238, 190, 122, 0.35); }
  /* 彩蛋触发：小聪开心到跳起 */
  #aipet.aipet-egg .aipet-face{ animation: aipet-egg-jump 0.5s cubic-bezier(0.34, 1.56, 0.64, 1) 4; }
  @keyframes aipet-egg-jump {
    0%, 100% { transform: translateY(0) rotate(0); }
    40% { transform: translateY(-20px) rotate(-8deg); }
    70% { transform: translateY(0) scale(1.06, 0.92); }
  }

  /* ---------- 对话面板 ---------- */
  #aipet .aipet-panel {
    position: absolute; right: 0; bottom: 100px;
    width: min(348px, calc(100vw - 2rem)); height: min(500px, calc(100dvh - 9rem));
    display: flex; flex-direction: column;
    background: var(--paper); color: var(--ink);
    border: 1.5px solid var(--ink-20); border-radius: 20px;
    box-shadow: 0 18px 50px rgba(42, 22, 13, 0.22);
    overflow: hidden; transform-origin: bottom right;
    transition: width 0.35s cubic-bezier(0.23, 1, 0.32, 1), height 0.35s cubic-bezier(0.23, 1, 0.32, 1), transform 0.4s cubic-bezier(0.23, 1, 0.32, 1), opacity 0.3s ease;
  }
  /* 全屏模式 */
  #aipet .aipet-panel.expanded {
    position: fixed; inset: 0; width: auto; height: auto;
    border-radius: 0; transform-origin: center;
  }
  /* 全屏时内容限宽居中，行不会拉到一整屏那么长 */
  #aipet .aipet-panel.expanded .aipet-msgs,
  #aipet .aipet-panel.expanded .aipet-chips,
  #aipet .aipet-panel.expanded .aipet-privacy,
  #aipet .aipet-panel.expanded .aipet-attach,
  #aipet .aipet-panel.expanded .aipet-form { max-width: 880px; width: 100%; margin-left: auto; margin-right: auto; }
  #aipet .aipet-panel.expanded .aipet-form { padding-left: 1rem; padding-right: 1rem; box-sizing: border-box; }
#aipet .aipet-panel[hidden]{ display: flex; transform: scale(0.6) translateY(24px); opacity: 0; pointer-events: none; }
  #aipet .aipet-head {
    display: flex; align-items: center; gap: 0.6rem;
    padding: 0.65rem 0.8rem; border-bottom: 1.5px solid var(--ink-10);
    background: var(--paper-sunken);
  }
#aipet .aipet-mini{ width: 34px; height: 34px; flex: none; }
#aipet .aipet-mini svg{ width: 100%; height: 100%; overflow: visible; display: block; }
#aipet .aipet-mini .aipet-body{ stroke-width: 6; }
#aipet .mini-pupil{ fill: var(--ink); }
#aipet .mini-mouth{ stroke: var(--ink); stroke-width: 5; }
#aipet .aipet-eyes-mini{ transform-origin: 60px 56px; transform-box: view-box; animation: aipet-blink-mini 4.2s infinite; }
  @keyframes aipet-blink-mini { 0%, 94%, 100% { transform: scaleY(1); } 97% { transform: scaleY(0.1); } }
#aipet .aipet-title{ flex: 1; line-height: 1.25; display: flex; flex-direction: column; }
#aipet .aipet-title strong{ font-size: 0.95rem; }
#aipet .aipet-title em{ font-style: normal; color: var(--ink-60); font-size: 0.62rem; letter-spacing: 0.1em; }
#aipet .aipet-close{
    flex: none; width: 32px; height: 32px; display: grid; place-items: center;
    background: none; border: 0; color: var(--ink-60); cursor: pointer; border-radius: 10px;
  }
#aipet .aipet-close:hover{ background: var(--ink-10); color: var(--ink); }
#aipet .aipet-clear{ flex: none; width: 32px; height: 32px; display: grid; place-items: center; background: none; border: 0; color: var(--ink-60); cursor: pointer; border-radius: 8px; }
#aipet .aipet-clear:hover{ background: var(--ink-10); color: var(--ink); }
#aipet .aipet-expand{ flex: none; width: 32px; height: 32px; display: grid; place-items: center; background: none; border: 0; color: var(--ink-60); cursor: pointer; border-radius: 8px; }
#aipet .aipet-expand:hover{ background: var(--ink-10); color: var(--ink); }
#aipet .aipet-expand[aria-pressed="true"]{ color: var(--ink); background: var(--ink-10); }
#aipet .aipet-scope{ display: flex; justify-content: space-between; align-items: center; gap: 0.6rem; padding: 0.35rem 0.85rem; background: var(--paper-sunken); border-bottom: 1px solid var(--ink-10); color: var(--ink-80); font-size: 0.72rem; }
#aipet .aipet-scope[hidden]{ display: none; }
#aipet .aipet-scope span{ overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
#aipet .aipet-scope button{ flex: none; border: 0; background: none; color: var(--ink-60); font: inherit; text-decoration: underline; cursor: pointer; }

#aipet .aipet-msgs{ flex: 1; overflow-y: auto; padding: 0.95rem 0.9rem; display: flex; flex-direction: column; gap: 0.7rem; scroll-behavior: smooth; }

  /* 消息行：头像 + 气泡，左右分明 */
#aipet .msg-row{ display: flex; align-items: flex-end; gap: 0.45rem; max-width: 100%; animation: msg-pop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1); }
#aipet .msg-row.user{ flex-direction: row-reverse; }
  @keyframes msg-pop {
    from { opacity: 0; transform: translateY(8px) scale(0.96); }
    to   { opacity: 1; transform: translateY(0) scale(1); }
  }
  #aipet .msg-avatar {
    width: 26px; height: 26px; flex: none; border-radius: 50%;
    display: grid; place-items: center; font-size: 0.66rem; user-select: none;
  }
#aipet .msg-row.bot .msg-avatar{ background: var(--paper-sunken); border: 1px solid var(--ink-10); color: var(--ink); padding: 2.5px; }
#aipet .msg-row.bot .msg-avatar svg{ width: 100%; height: 100%; display: block; }
#aipet .msg-row.user .msg-avatar{ background: var(--ink); color: var(--paper); font-weight: 600; }

#aipet .msg{ max-width: 76%; padding: 0.55rem 0.8rem; border-radius: 16px; font-size: 0.88rem; line-height: 1.65; white-space: pre-wrap; word-break: break-word; }
  #aipet .msg.bot {
    background: var(--paper-sunken); color: var(--ink);
    border: 1px solid var(--ink-10); border-bottom-left-radius: 5px;
    box-shadow: 0 1px 3px rgba(42, 22, 13, 0.06);
  }
  #aipet .msg.user {
    background: var(--ink); color: var(--paper);
    border-bottom-right-radius: 5px;
    box-shadow: 0 2px 7px rgba(42, 22, 13, 0.2);
  }
#aipet .msg-img{ display: block; max-width: 200px; max-height: 140px; border-radius: 10px; margin-top: 0.4rem; border: 1px solid var(--ink-10); object-fit: cover; }
#aipet .msg.user .msg-img{ border-color: rgba(252, 252, 248, 0.25); }
#aipet .aipet-sources{ display: flex; flex-wrap: wrap; gap: 0.35rem; padding-left: 2.2rem; }
#aipet .aipet-sources a{ max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; padding: 0.18rem 0.4rem; border: 1px solid var(--ink-20); border-radius: 4px; color: var(--ink-80); font-size: 0.7rem; text-decoration: none; }
#aipet .aipet-sources a:hover{ border-color: var(--ink-60); }
#aipet .msg.typing{ display: inline-flex; gap: 4px; align-items: center; padding: 0.75rem 0.85rem; }
#aipet .msg.typing i{ width: 6px; height: 6px; border-radius: 50%; background: var(--ink-60); animation: aipet-dot 1s ease-in-out infinite; }
#aipet .msg.typing i:nth-child(2){ animation-delay: 0.15s; }
#aipet .msg.typing i:nth-child(3){ animation-delay: 0.3s; }
  @keyframes aipet-dot { 40% { transform: translateY(-4px); opacity: 1; } 0%, 100% { opacity: 0.4; } }

#aipet .aipet-chips{ display: flex; gap: 0.4rem; padding: 0 0.8rem 0.55rem; flex-wrap: wrap; }
#aipet .aipet-chips:empty{ display: none; }
#aipet .aipet-attach{ display: flex; gap: 0.4rem; padding: 0 0.8rem 0.55rem; flex-wrap: wrap; }
#aipet .aipet-attach[hidden]{ display: none; }
#aipet .attach-item{ position: relative; width: 52px; height: 52px; }
#aipet .attach-item img{ width: 100%; height: 100%; object-fit: cover; border-radius: 8px; border: 1px solid var(--ink-20); }
#aipet .attach-item.attach-file{ width: auto; max-width: 180px; height: 30px; align-self: center; }
#aipet .attach-file-name{
  display: inline-block; padding: 0.28em 0.6em; font-size: 0.72rem; line-height: 1.3;
  background: var(--paper-sunken); border: 1px solid var(--ink-20); border-radius: 8px;
  color: var(--ink-80); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 150px;
}
#aipet .attach-file .attach-rm{ top: -7px; right: -7px; }
#aipet .attach-rm{
    position: absolute; top: -6px; right: -6px; width: 18px; height: 18px;
    border-radius: 50%; border: 0; background: var(--ink); color: var(--paper);
    font-size: 12px; line-height: 1; cursor: pointer; display: grid; place-items: center;
  }
  #aipet .chip {
    font-size: 0.74rem; padding: 0.28em 0.75em; border-radius: 99px; cursor: pointer;
    background: none; border: 1px solid var(--ink-20); color: var(--ink-60); font-family: inherit;
    transition: color 0.2s, border-color 0.2s;
  }
#aipet .chip:hover{ color: var(--ink); border-color: var(--ink-60); }
#aipet .aipet-privacy{ padding: 0.4rem 0.8rem; border-top: 1px solid var(--ink-10); color: var(--ink-60); font-size: 0.66rem; line-height: 1.35; }

#aipet .aipet-form{ display: flex; gap: 0.5rem; padding: 0.65rem 0.8rem; border-top: 1.5px solid var(--ink-10); }
  #aipet .aipet-input {
    flex: 1; min-width: 0; padding: 0.5rem 0.75rem; font: inherit; font-size: 0.88rem;
    background: var(--paper-sunken); color: var(--ink);
    border: 1px solid var(--ink-10); border-radius: 12px; outline: none;
