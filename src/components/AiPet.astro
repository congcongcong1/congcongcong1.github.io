#aipet .aipet-input:focus{ border-color: var(--ink-40); }
  #aipet .aipet-attach-btn {
    flex: none; width: 40px; height: 40px; display: grid; place-items: center;
    background: var(--paper-sunken); color: var(--ink-60); border: 1px solid var(--ink-10); border-radius: 12px; cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), color 0.2s ease;
  }
#aipet .aipet-attach-btn:hover{ color: var(--ink); transform: translateY(-2px) rotate(90deg); }
  #aipet .aipet-send {
    flex: none; width: 40px; height: 40px; display: grid; place-items: center;
    background: var(--ink); color: var(--paper); border: 0; border-radius: 12px; cursor: pointer;
    transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
#aipet .aipet-send:hover{ transform: translateY(-2px) rotate(-8deg); }

  /* 夜间模式：加一层暖光晕，让它在夜空中发光 */
  body.night #aipet .aipet-face { filter: drop-shadow(0 0 16px rgba(238, 190, 122, 0.5)) drop-shadow(0 6px 18px rgba(0, 0, 0, 0.4)); }
  body.night #aipet .aipet-body { fill: #332216; }
  body.night #aipet .eye-white { fill: #332216; }
  body.night #aipet .aipet-panel { border-color: rgba(238, 190, 122, 0.25); box-shadow: 0 18px 50px rgba(0, 0, 0, 0.55); }

  @media (max-width: 560px) {
#aipet .aipet-face{ width: 56px; height: 56px; }
#aipet .aipet-panel{ right: -0.2rem; bottom: 72px; }
#aipet .aipet-tag{ font-size: 0.55rem; }
#aipet .aipet-mood{ bottom: 64px; font-size: 0.66rem; }
  }
