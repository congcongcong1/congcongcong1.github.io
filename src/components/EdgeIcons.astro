---
// 边缘图标带：固定视口左右两缘散布同款细线小图标，
// 首页滚过 Hero 后才淡入（避免与首屏图标重叠），其他页面直接显示。
// pointer-events:none、贴屏幕边缘，绝不影响阅读。
interface IconSpec {
  x: number; y: number; s: number; d: number; dur: number; cls?: string; svg: string;
}
const stroke = 'fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"';
const icons: IconSpec[] = [
  // 左缘
  { x: 3.5, y: 12, s: 17, d: 0.7, dur: 7.6, cls: 'c-lav', svg: `<path d="M12 3l1.9 5.6 5.6 1.9-5.6 1.9L12 18l-1.9-5.6-5.6-1.9 5.6-1.9Z" ${stroke}/>` },
  { x: 5.5, y: 30, s: 19, d: 0.9, dur: 6.4, cls: 'c-blue', svg: `<path d="M9 18V5l12-2v13" ${stroke}/><circle cx="6" cy="18" r="3" ${stroke}/><circle cx="18" cy="16" r="3" ${stroke}/>` },
  { x: 2.5, y: 48, s: 20, d: 1.0, dur: 8.5, cls: 'c-gold', svg: `<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" ${stroke}/>` },
  { x: 6,   y: 66, s: 17, d: 0.6, dur: 7.0, svg: `<path d="M17 8h1a4 4 0 1 1 0 8h-1" ${stroke}/><path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" ${stroke}/>` },
  { x: 3,   y: 84, s: 18, d: 0.8, dur: 6.7, cls: 'c-mint', svg: `<path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20V2H6.5A2.5 2.5 0 0 0 4 4.5v15Z" ${stroke}/><path d="M4 19.5A2.5 2.5 0 0 0 6.5 22H20v-5" ${stroke}/>` },
  // 右缘
  { x: 96.5, y: 14, s: 18, d: 0.8, dur: 6.9, cls: 'c-orange', svg: `<rect x="3" y="4" width="18" height="16" rx="2" ${stroke}/><path d="M7 4v16M17 4v16M3 9h4M3 15h4M17 9h4M17 15h4" ${stroke}/>` },
  { x: 94,   y: 32, s: 22, d: 1.0, dur: 7.9, cls: 'c-lav', svg: `<circle cx="12" cy="12" r="5.5" ${stroke}/><path d="M3.6 9.5c-1 3.6 1.7 5.7 5.5 6.6 4.9 1.1 10.7.6 11.9-2.5 1-2.7-1.4-4.8-4.6-6.1" ${stroke}/>` },
  { x: 97,   y: 52, s: 19, d: 0.7, dur: 6.3, cls: 'c-mint', svg: `<path d="M17.3 5H6.7a4 4 0 0 0-4 3.6L2 14.6A2.6 2.6 0 0 0 6.6 16l1-2h8.8l1 2a2.6 2.6 0 0 0 4.6-1.4l-.7-6A4 4 0 0 0 17.3 5Z" ${stroke}/><path d="M6 12h4M8 10v4" ${stroke}/><path d="M15.5 11.5h.01M18.5 13h.01" ${stroke}/>` },
  { x: 94.5, y: 72, s: 17, d: 0.9, dur: 7.3, svg: `<path d="M4 8h3l2-3h6l2 3h3a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1Z" ${stroke}/><circle cx="12" cy="13" r="3.5" ${stroke}/>` },
  { x: 96,   y: 90, s: 16, d: 0.5, dur: 6.6, cls: 'c-blue', svg: `<path d="M22 2L11 13" ${stroke}/><path d="M22 2l-7 20-4-9-9-4Z" ${stroke}/>` },
];
---
<div class="edge-icons" id="edge-icons" aria-hidden="true">
  {icons.map((ic, i) => (
    <span
      class={`edge-icon ${ic.cls ?? ''}`}
      data-depth={ic.d}
      style={`left:${ic.x}%; top:${ic.y}%; width:${ic.s}px; height:${ic.s}px; animation-duration:${ic.dur}s; animation-delay:${(-i * 1.1).toFixed(1)}s;`}
    ><svg viewBox="0 0 24 24" set:html={ic.svg} /></span>
  ))}
</div>

<style>
  .edge-icons {
    position: fixed;
    inset: 0;
    z-index: 1;                    /* 内容之下？不——内容无统一 z-index，用低透明度保证不干扰 */
    pointer-events: none;
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .edge-icons.on { opacity: 1; }
  .edge-icon {
    position: absolute;
    color: rgba(42, 22, 13, 0.22);
    animation-name: edge-bob;
    animation-timing-function: ease-in-out;
    animation-iteration-count: infinite;
    animation-direction: alternate;
    will-change: transform;
  }
  .edge-icon svg { display: block; width: 100%; height: 100%; }
  .c-lav    { color: rgba(139, 120, 180, 0.5); }
  .c-mint   { color: rgba(104, 164, 126, 0.48); }
  .c-blue   { color: rgba(146, 176, 212, 0.55); }
  .c-gold   { color: rgba(196, 156, 66, 0.42); }
  .c-orange { color: rgba(222, 166, 86, 0.48); }

  body.night .edge-icon           { color: rgba(242, 234, 217, 0.24); }
  body.night .c-lav               { color: rgba(163, 148, 194, 0.45); }
  body.night .c-mint              { color: rgba(124, 181, 144, 0.4); }
  body.night .c-blue              { color: rgba(169, 192, 220, 0.45); }
  body.night .c-gold              { color: rgba(240, 215, 140, 0.38); }
  body.night .c-orange            { color: rgba(238, 190, 122, 0.4); }

  @keyframes edge-bob {
    from { transform: translateY(-5px) rotate(-3deg); }
    to   { transform: translateY(6px)  rotate(4deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .edge-icon { animation: none; }
  }
  /* 窄屏边缘空间不足，直接隐藏 */
  @media (max-width: 900px) {
    .edge-icons { display: none; }
  }
</style>

<script>
  // 首页：滚过 Hero 后淡入；无 Hero 的页面直接显示
  // 笔记文章页是三栏布局，左右侧栏占满边缘，图标带会遮挡，直接不渲染
  const root = document.getElementById('edge-icons');
  if (root) {
    if (document.querySelector('.notes-layout')) {
      root.remove();
    } else {
      const hero = document.querySelector('.hero');
      if (hero) {
        new IntersectionObserver((entries) => {
          root.classList.toggle('on', !entries[0].isIntersecting);
        }, { rootMargin: '-40% 0px 0px 0px' }).observe(hero);
      } else {
        root.classList.add('on');
      }
    }
  }

  // 轻微鼠标视差（scoped 到本组件，translate 属性与 bob 动画叠加不冲突）
  const fine = window.matchMedia('(pointer: fine)').matches;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const els = root ? Array.from(root.querySelectorAll<HTMLElement>('.edge-icon')) : [];
  if (root && fine && !reduced && els.length) {
    let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0, active = false;
    const loop = () => {
      cx += (tx - cx) * 0.05;
      cy += (ty - cy) * 0.05;
      for (const el of els) {
        const d = parseFloat(el.dataset.depth || '0.5');
        el.style.translate = `${(-cx * d * 12).toFixed(1)}px ${(-cy * d * 9).toFixed(1)}px`;
      }
      if (Math.abs(tx - cx) > 0.001 || Math.abs(ty - cy) > 0.001 || active) {
        raf = requestAnimationFrame(loop);
      } else {
        raf = 0;
      }
    };
    const kick = () => { if (!raf) raf = requestAnimationFrame(loop); };
    window.addEventListener('mousemove', (e) => {
      tx = (e.clientX / window.innerWidth - 0.5) * 2;
      ty = (e.clientY / window.innerHeight - 0.5) * 2;
      active = true;
      kick();
      clearTimeout((kick as any)._t);
      (kick as any)._t = setTimeout(() => { active = false; kick(); }, 120);
    }, { passive: true });
  }
</script>
