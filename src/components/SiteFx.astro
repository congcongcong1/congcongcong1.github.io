---
// 全站趣味动效：
// 1) 点击任意处绽出小星星  2) 键盘输入 "kaiser" 触发星雨彩蛋
// 3) 文章阅读进度条        4) 页脚实时时钟与站龄
// 全部尊重 prefers-reduced-motion
---

<div id="read-progress" aria-hidden="true"></div>

<script>
  (() => {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const PALETTE = ['#a394c2', '#7cb590', '#a9c0dc', '#f0d78c', '#eebe7a'];

    /* ---------- 1) 点击星星 ---------- */
    if (!reduced) {
      document.addEventListener('click', (e) => {
        // 链接点击不挡路，星星画在按钮后面
        const star = document.createElement('span');
        star.className = 'click-star';
        star.textContent = '✦';
        star.style.left = e.clientX + 'px';
        star.style.top = e.clientY + 'px';
        star.style.color = PALETTE[(Math.random() * PALETTE.length) | 0];
        star.style.fontSize = 10 + Math.random() * 10 + 'px';
        document.body.appendChild(star);
        star.addEventListener('animationend', () => star.remove());
      }, { passive: true });
    }

    /* ---------- 2) kaiser 星雨彩蛋 ---------- */
    if (!reduced) {
      let buffer = '';
      document.addEventListener('keydown', (e) => {
        if (e.key.length !== 1) return;
        buffer = (buffer + e.key.toLowerCase()).slice(-6);
        if (buffer === 'kaiser') starShower();
      });
    }

    function starShower() {
      const layer = document.createElement('div');
      layer.className = 'star-shower';
      for (let i = 0; i < 42; i++) {
        const s = document.createElement('span');
        s.textContent = Math.random() > 0.4 ? '✦' : '✧';
        s.style.left = Math.random() * 100 + 'vw';
        s.style.color = PALETTE[(Math.random() * PALETTE.length) | 0];
        s.style.fontSize = 8 + Math.random() * 14 + 'px';
        s.style.animationDuration = 1.6 + Math.random() * 1.6 + 's';
        s.style.animationDelay = Math.random() * 0.7 + 's';
        layer.appendChild(s);
      }
      document.body.appendChild(layer);
      setTimeout(() => layer.remove(), 4500);
    }

    /* ---------- 3) 阅读进度条 ---------- */
    const bar = document.getElementById('read-progress');
    if (bar) {
      let ticking = false;
      const update = () => {
        ticking = false;
        const max = document.documentElement.scrollHeight - window.innerHeight;
        bar.style.transform = 'scaleX(' + (max > 0 ? Math.min(window.scrollY / max, 1) : 0) + ')';
      };
      window.addEventListener('scroll', () => {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      }, { passive: true });
      update();
    }

    /* ---------- 4) 页脚时钟与站龄 ---------- */
    const clock = document.getElementById('site-clock');
    if (clock) {
      const since = new Date(clock.dataset.since + 'T00:00:00');
      const pad = (n) => String(n).padStart(2, '0');
      const tick = () => {
        const now = new Date();
        const days = Math.max(1, Math.floor((now - since) / 86400000) + 1);
        clock.textContent = '已运行 ' + days + ' 天 · ' +
          pad(now.getHours()) + ':' + pad(now.getMinutes()) + ':' + pad(now.getSeconds());
      };
      tick();
      setInterval(tick, 1000);
    }

    /* ---------- 5) 夜间星空模式 ---------- */
    const nightBtn = document.getElementById('night-toggle');
    if (nightBtn) {
      const moon = nightBtn.querySelector('.icon-moon');
      const sun = nightBtn.querySelector('.icon-sun');
      const meta = document.querySelector('meta[name="theme-color"]');
      const applyNight = (on) => {
        document.body.classList.toggle('night', on);
        nightBtn.setAttribute('aria-pressed', String(on));
        if (moon) moon.style.display = on ? 'none' : '';
        if (sun) sun.style.display = on ? '' : 'none';
        if (meta) meta.setAttribute('content', on ? '#241812' : '#f7f5fb');
      };
      applyNight(localStorage.getItem('night') === '1');
      nightBtn.addEventListener('click', () => {
        const on = !document.body.classList.contains('night');
        applyNight(on);
        localStorage.setItem('night', on ? '1' : '0');
      });
    }

    /* ---------- 6) 彗星光标拖尾（仅桌面鼠标） ---------- */
    (function cometTrail() {
      if (matchMedia('(pointer: coarse)').matches) return;
      let lastX = -100, lastY = -100, lastT = 0;
      document.addEventListener('pointermove', (e) => {
        if (e.pointerType !== 'mouse') return;
        if (reduced || document.body.classList.contains('night')) return;
        const now = performance.now();
        if (now - lastT < 30) return;
        const dx = e.clientX - lastX, dy = e.clientY - lastY;
        if (dx * dx + dy * dy < 324) return; // <18px
        lastX = e.clientX; lastY = e.clientY; lastT = now;
        const dot = document.createElement('span');
        dot.className = 'comet-dot';
        dot.style.left = e.clientX + 'px';
        dot.style.top = e.clientY + 'px';
        dot.style.width = dot.style.height = (2 + Math.random() * 3).toFixed(1) + 'px';
        dot.style.background = PALETTE[(Math.random() * PALETTE.length) | 0];
        dot.addEventListener('animationend', () => dot.remove());
        document.body.appendChild(dot);
      }, { passive: true });
    })();

    /* ---------- 7) 不蒜子计数兜底：服务异常时隐藏 ---------- */
    window.addEventListener('load', () => {
      setTimeout(() => {
        const pv = document.getElementById('busuanzi_value_site_pv');
        const stat = document.getElementById('visit-stat');
        if (stat && pv && pv.textContent.trim() === '–') stat.style.display = 'none';
      }, 5000);
    });
  })();
</script>
