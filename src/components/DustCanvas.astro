---
// 内容区背景：缓慢漂浮的星尘粒子 + 鼠标视差 + 淡星座连线
// 灵感来自星空的呼吸感；颜色取站点调色板（墨棕 / 薰衣草 / 薄荷），低透明度不干扰阅读
---

<canvas class="dust-canvas" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.dust-canvas');
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const parent = canvas.parentElement!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const PALETTE = [
      [42, 22, 13],    // 墨棕
      [42, 22, 13],
      [163, 148, 194], // 薰衣草
      [124, 181, 144], // 薄荷
      [169, 192, 220], // 粉末蓝
    ];

    interface Dot {
      x: number; y: number; r: number;
      vx: number; vy: number;
      depth: number; phase: number; speed: number;
      color: number[];
      baseAlpha: number;
    }

    let dots: Dot[] = [];
    let w = 0, h = 0, dpr = 1;
    let mx = 0, my = 0;       // 鼠标相对中心，平滑后
    let tmx = 0, tmy = 0;     // 目标
    let raf = 0;
    let running = false;
    let time = 0;

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = parent.clientWidth;
      h = parent.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      seed();
    }

    function seed() {
      const n = Math.max(48, Math.min(140, Math.round((w * h) / 11000)));
      dots = Array.from({ length: n }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: 0.7 + Math.random() * 1.3,
        vx: (Math.random() - 0.5) * 0.14,
        vy: (Math.random() - 0.5) * 0.14,
        depth: 0.3 + Math.random() * 0.7,
        phase: Math.random() * Math.PI * 2,
        speed: 0.4 + Math.random() * 0.8,
        color: PALETTE[(Math.random() * PALETTE.length) | 0],
        baseAlpha: 0.16 + Math.random() * 0.22,
      }));
    }

    function frame() {
      time += 0.016;
      mx += (tmx - mx) * 0.04;
      my += (tmy - my) * 0.04;
      ctx.clearRect(0, 0, w, h);

      // 星座连线（距离近才连，极淡）
      ctx.lineWidth = 0.5;
      for (let i = 0; i < dots.length; i++) {
        const a = dots[i];
        const ax = a.x + mx * a.depth * 14;
        const ay = a.y + my * a.depth * 14;
        for (let j = i + 1; j < dots.length; j++) {
          const b = dots[j];
          const bx = b.x + mx * b.depth * 14;
          const by = b.y + my * b.depth * 14;
          const dx = ax - bx, dy = ay - by;
          const d2 = dx * dx + dy * dy;
          if (d2 < 8100) { // 90px
            const alpha = (1 - Math.sqrt(d2) / 90) * 0.1;
            ctx.strokeStyle = `rgba(42, 22, 13, ${alpha})`;
            ctx.beginPath();
            ctx.moveTo(ax, ay);
            ctx.lineTo(bx, by);
            ctx.stroke();
          }
        }
      }

      // 星尘点：缓慢漂移 + 呼吸闪烁
      for (const d of dots) {
        if (!reduced) {
          d.x += d.vx;
          d.y += d.vy;
          if (d.x < -4) d.x = w + 4;
          if (d.x > w + 4) d.x = -4;
          if (d.y < -4) d.y = h + 4;
          if (d.y > h + 4) d.y = -4;
        }
        const twinkle = reduced ? 1 : 0.55 + 0.45 * Math.sin(time * d.speed + d.phase);
        const alpha = d.baseAlpha * twinkle;
        ctx.fillStyle = `rgba(${d.color[0]}, ${d.color[1]}, ${d.color[2]}, ${alpha})`;
        ctx.beginPath();
        ctx.arc(d.x + mx * d.depth * 14, d.y + my * d.depth * 14, d.r, 0, Math.PI * 2);
        ctx.fill();
      }

      if (running) raf = requestAnimationFrame(frame);
    }

    function start() {
      if (running || reduced) return;
      running = true;
      raf = requestAnimationFrame(frame);
    }
    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    window.addEventListener('resize', resize, { passive: true });
    window.addEventListener('mousemove', (e) => {
      tmx = (e.clientX / window.innerWidth - 0.5) * 2;
      tmy = (e.clientY / window.innerHeight - 0.5) * 2;
    }, { passive: true });

    // 离开视口时暂停，省电
    new IntersectionObserver((entries) => {
      entries[0].isIntersecting ? start() : stop();
    }, { rootMargin: '80px' }).observe(parent);

    resize();
    if (reduced) frame(); // 减少动态偏好：只画一帧静态星尘
  }
</script>
