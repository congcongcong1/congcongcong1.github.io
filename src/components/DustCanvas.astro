---
// 内容区背景：失焦光斑（bokeh）+ 极细闪烁微尘 + 鼠标视差
// 审美取向：大光圈镜头下的午后光雾——安静、温暖、不打扰阅读
// 光斑预渲染为渐变精灵，性能好；颜色取站点调色板，低透明度
---

<canvas class="dust-canvas" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.dust-canvas');
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const parent = canvas.parentElement!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const PALETTE = [
      [163, 148, 194], // 薰衣草
      [124, 181, 144], // 薄荷
      [169, 192, 220], // 粉末蓝
      [240, 215, 140], // 麦金
      [238, 190, 122], // 蜂蜜橙
    ];

    // 预渲染光斑精灵：径向渐变，边缘自然虚化
    const SPRITE = 256;
    const sprites = PALETTE.map(([r, g, b]) => {
      const c = document.createElement('canvas');
      c.width = c.height = SPRITE;
      const sctx = c.getContext('2d')!;
      const grad = sctx.createRadialGradient(SPRITE / 2, SPRITE / 2, 0, SPRITE / 2, SPRITE / 2, SPRITE / 2);
      grad.addColorStop(0, `rgba(${r},${g},${b},1)`);
      grad.addColorStop(0.45, `rgba(${r},${g},${b},0.32)`);
      grad.addColorStop(1, `rgba(${r},${g},${b},0)`);
      sctx.fillStyle = grad;
      sctx.fillRect(0, 0, SPRITE, SPRITE);
      return c;
    });

    interface Orb {
      x: number; y: number; r: number;
      ax: number; ay: number;          // 漂移振幅
      phase: number; speed: number;
      depth: number;                   // 视差深度
      sprite: number;
      alpha: number;
    }
    interface Mote {
      x: number; y: number; r: number;
      phase: number; speed: number;
      depth: number;
      color: number[];
      baseAlpha: number;
    }

    let orbs: Orb[] = [];
    let motes: Mote[] = [];
    let w = 0, h = 0, dpr = 1;
    let mx = 0, my = 0;
    let tmx = 0, tmy = 0;
    let raf = 0;
    let running = false;
    let time = 0;

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = parent.clientWidth;
      h = parent.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      seed();
    }

    function seed() {
      const area = w * h;
      const orbN = Math.max(9, Math.min(16, Math.round(area / 90000)));
      const moteN = Math.max(26, Math.min(64, Math.round(area / 20000)));
      orbs = Array.from({ length: orbN }, (_, i) => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: 50 + Math.random() * 110 + (i === 0 ? 90 : 0), // 留一颗特别大的压场
        ax: 20 + Math.random() * 40,
        ay: 14 + Math.random() * 30,
        phase: Math.random() * Math.PI * 2,
        speed: 0.08 + Math.random() * 0.12,
        depth: 0.25 + Math.random() * 0.75,
        sprite: (Math.random() * PALETTE.length) | 0,
        alpha: 0.08 + Math.random() * 0.07,
      }));
      motes = Array.from({ length: moteN }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        r: 0.6 + Math.random() * 1.1,
        phase: Math.random() * Math.PI * 2,
        speed: 0.5 + Math.random() * 0.9,
        depth: 0.3 + Math.random() * 0.7,
        color: Math.random() < 0.6 ? [42, 22, 13] : PALETTE[(Math.random() * PALETTE.length) | 0],
        baseAlpha: 0.1 + Math.random() * 0.16,
      }));
    }

    function frame() {
      time += 0.016;
      mx += (tmx - mx) * 0.045;
      my += (tmy - my) * 0.045;
      ctx.clearRect(0, 0, w, h);

      const night = document.body.classList.contains('night');
      const nightBoost = night ? 1.55 : 1;

      // 光斑：缓慢的正弦漂移 + 呼吸明灭 + 视差
      for (const o of orbs) {
        const ox = o.x + Math.sin(time * o.speed + o.phase) * o.ax + mx * o.depth * 22;
        const oy = o.y + Math.cos(time * o.speed * 0.8 + o.phase) * o.ay + my * o.depth * 22;
        const breathe = 0.8 + 0.2 * Math.sin(time * 0.35 + o.phase * 1.7);
        ctx.globalAlpha = Math.min(o.alpha * breathe * nightBoost, 0.22);
        const d = o.r * 2;
        ctx.drawImage(sprites[o.sprite], ox - o.r, oy - o.r, d, d);
      }

      // 微尘：原地闪烁，不漂移
      for (const m of motes) {
        const twinkle = reduced ? 1 : 0.5 + 0.5 * Math.sin(time * m.speed + m.phase);
        const a = m.baseAlpha * twinkle * (night ? 1.7 : 1);
        ctx.globalAlpha = Math.min(a, 0.4);
        ctx.fillStyle = `rgb(${m.color[0]},${m.color[1]},${m.color[2]})`;
        ctx.beginPath();
        ctx.arc(m.x + mx * m.depth * 14, m.y + my * m.depth * 14, m.r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;

      if (running) raf = requestAnimationFrame(frame);
    }

    function start() {
      if (running || reduced) return;
      running = true;
      raf = requestAnimationFrame(frame);
    }
    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    window.addEventListener('resize', resize, { passive: true });
    window.addEventListener('mousemove', (e) => {
      tmx = (e.clientX / window.innerWidth - 0.5) * 2;
      tmy = (e.clientY / window.innerHeight - 0.5) * 2;
    }, { passive: true });

    // 离开视口时暂停，省电
    new IntersectionObserver((entries) => {
      entries[0].isIntersecting ? start() : stop();
    }, { rootMargin: '80px' }).observe(parent);

    resize();
    if (reduced) frame(); // 减少动态偏好：只画一帧静态光雾
  }
</script>
