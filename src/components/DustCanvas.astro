---
// 内容区背景：织光 —— 竖纹织线肌理
// 技法：竖条织幅 × 2-3px 间距的横丝线，逐纹差速横移产生「织机在动」的错觉；
// 少量经线缓慢换色（活色），纸感底线维持阅读安静。夜间经线发光。
---

<canvas class="dust-canvas" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.dust-canvas');
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const parent = canvas.parentElement!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 站点调色板：经线（彩色）与纬线（纸色）
    const WARP = [
      [163, 148, 194], // 薰衣草
      [124, 181, 144], // 薄荷
      [169, 192, 220], // 粉末蓝
      [240, 215, 140], // 麦金
      [238, 190, 122], // 蜂蜜橙
    ];
    const PAPER = [42, 22, 13];       // 墨棕纬线（白天）
    const PAPER_NIGHT = [242, 234, 217]; // 暖白纬线（夜间）

    interface Stripe {
      w: number;              // 织幅宽
      x: number;              // 当前位置
      speed: number;          // 差速横移
      gap: number;            // 丝线间距 2-3px
      warp: number;           // 经线索引，-1 = 纸色纬线
      morph: number;          // 换色速度（0 = 不换）
      alpha: number;
      phase: number;
    }

    let stripes: Stripe[] = [];
    let w = 0, h = 0, dpr = 1;
    let totalW = 0;
    let raf = 0;
    let running = false;
    let time = 0;
    let mx = 0, tmx = 0;

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = parent.clientWidth;
      h = parent.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      seed();
    }

    function seed() {
      // 织幅宽度覆盖约 1.5 屏，保证差速横移时不露底
      stripes = [];
      totalW = 0;
      const target = w * 1.6;
      while (totalW < target) {
        const isWarp = Math.random() < 0.3; // 三成为彩色经线
        const s: Stripe = {
          w: 36 + Math.random() * 90,
          x: totalW,
          speed: 2 + Math.random() * 7,       // px/s，逐纹不同 = 织机感
          gap: 2 + Math.random(),             // 2-3px 丝线间距
          warp: isWarp ? (Math.random() * WARP.length) | 0 : -1,
          morph: isWarp ? 0.05 + Math.random() * 0.1 : 0,
          alpha: isWarp ? 0.1 + Math.random() * 0.07 : 0.05 + Math.random() * 0.035,
          phase: Math.random() * Math.PI * 2,
        };
        stripes.push(s);
        totalW += s.w;
      }
    }

    function stripeColor(s: Stripe, night: boolean): string {
      if (s.warp < 0) {
        const c = night ? PAPER_NIGHT : PAPER;
        return `rgba(${c[0]},${c[1]},${c[2]},${(s.alpha * (night ? 0.9 : 1)).toFixed(3)})`;
      }
      // 活色：经线在调色板内缓慢循环
      const idx = s.morph > 0
        ? Math.floor(time * s.morph + s.phase) % WARP.length
        : s.warp;
      const c = WARP[(idx + WARP.length) % WARP.length];
      const a = s.alpha * (night ? 1.9 : 1.15);
      return `rgba(${c[0]},${c[1]},${c[2]},${Math.min(a, 0.28).toFixed(3)})`;
    }

    function frame() {
      time += 1 / 60;
      mx += (tmx - mx) * 0.04;
      ctx.clearRect(0, 0, w, h);
      const night = document.body.classList.contains('night');

      ctx.lineWidth = 1;
      for (const s of stripes) {
        if (!reduced) {
          s.x += s.speed / 60;
          if (s.x > totalW) s.x -= totalW;
        }
        const sx = ((s.x % totalW) + totalW) % totalW - (totalW - w) / 2 + mx * 6;
        if (sx > w || sx + s.w < 0) continue;
        ctx.strokeStyle = stripeColor(s, night);
        ctx.beginPath();
        const breathe = reduced ? 0 : Math.sin(time * 0.4 + s.phase) * s.gap * 0.25;
        for (let y = -2; y < h + 2; y += s.gap + breathe * 0.1) {
          ctx.moveTo(sx, y);
          ctx.lineTo(sx + s.w, y);
        }
        ctx.stroke();
      }

      if (running) raf = requestAnimationFrame(frame);
    }

    function start() {
      if (running || reduced) return;
      running = true;
      raf = requestAnimationFrame(frame);
    }
    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    window.addEventListener('resize', resize, { passive: true });
    window.addEventListener('mousemove', (e) => {
      tmx = (e.clientX / window.innerWidth - 0.5) * 2;
    }, { passive: true });

    new IntersectionObserver((entries) => {
      entries[0].isIntersecting ? start() : stop();
    }, { rootMargin: '80px' }).observe(parent);

    resize();
    if (reduced) frame();
  }
</script>
