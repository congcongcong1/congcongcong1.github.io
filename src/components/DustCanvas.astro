---
// 内容区背景：呼吸光晕 —— 三颗超大调色板光斑，极慢漂移，无点无线，
// 透明度压到 0.04–0.07，绝不影响阅读；夜间仅轻微提亮。
---

<canvas class="dust-canvas" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('.dust-canvas');
  if (canvas) {
    const ctx = canvas.getContext('2d')!;
    const parent = canvas.parentElement!;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 站点调色板（薰衣草/薄荷/粉末蓝/麦金/蜂蜜橙）
    const PALETTE: [number, number, number][] = [
      [163, 148, 194],
      [124, 181, 144],
      [169, 192, 220],
      [240, 215, 140],
      [238, 190, 122],
    ];

    interface Orb {
      bx: number; by: number;    // 基准位置（比例 0–1）
      r: number;                  // 半径 px
      ax: number; ay: number;     // 漂移振幅 px
      sx: number; sy: number;     // 漂移速度
      px: number; py: number;     // 相位
      ci: number;                 // 调色板索引
      alpha: number;              // 基准透明度
      sprite: HTMLCanvasElement;
    }

    let orbs: Orb[] = [];
    let w = 0, h = 0, dpr = 1;
    let raf = 0;
    let running = false;
    let time = Math.random() * 100;
    let mx = 0, tmx = 0, my = 0, tmy = 0;

    function makeSprite(r: number, c: [number, number, number]): HTMLCanvasElement {
      const s = document.createElement('canvas');
      const pad = Math.ceil(r * 0.35);
      s.width = s.height = (r + pad) * 2;
      const g = s.getContext('2d')!;
      const grad = g.createRadialGradient(s.width / 2, s.height / 2, 0, s.width / 2, s.height / 2, r + pad);
      grad.addColorStop(0, `rgba(${c[0]},${c[1]},${c[2]},1)`);
      grad.addColorStop(0.55, `rgba(${c[0]},${c[1]},${c[2]},0.35)`);
      grad.addColorStop(1, `rgba(${c[0]},${c[1]},${c[2]},0)`);
      g.fillStyle = grad;
      g.fillRect(0, 0, s.width, s.height);
      return s;
    }

    function resize() {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = parent.clientWidth;
      h = parent.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvas.style.width = w + 'px';
      canvas.style.height = h + 'px';
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      seed();
    }

    function seed() {
      const base = Math.min(Math.max(w, h), 1400);
      orbs = [
        { bx: 0.12, by: 0.10, r: base * 0.38, ax: 60, ay: 40, sx: 0.11, sy: 0.09, px: 0.0, py: 2.1, ci: 0, alpha: 0.055 },
        { bx: 0.88, by: 0.38, r: base * 0.46, ax: 70, ay: 50, sx: 0.08, sy: 0.12, px: 1.4, py: 0.6, ci: 2, alpha: 0.05 },
        { bx: 0.30, by: 0.85, r: base * 0.40, ax: 55, ay: 45, sx: 0.10, sy: 0.08, px: 3.1, py: 4.0, ci: 3, alpha: 0.045 },
      ].map((o) => ({ ...o, sprite: makeSprite(o.r, PALETTE[o.ci]) }));
    }

    let tick = 0;
    function frame() {
      if (running) raf = requestAnimationFrame(frame);
      // 省电：跳帧渲染 30fps
      if (++tick % 2) return;
      time += 1 / 30;
      mx += (tmx - mx) * 0.06;
      my += (tmy - my) * 0.06;
      ctx.clearRect(0, 0, w, h);
      const night = document.body.classList.contains('night');
      const boost = night ? 1.6 : 1;

      ctx.globalCompositeOperation = night ? 'lighter' : 'source-over';
      for (const o of orbs) {
        const ox = o.bx * w + (reduced ? 0 : Math.sin(time * o.sx + o.px) * o.ax) - mx * 22;
        const oy = o.by * h + (reduced ? 0 : Math.cos(time * o.sy + o.py) * o.ay) - my * 16;
        ctx.globalAlpha = Math.min(o.alpha * boost, 0.14);
        ctx.drawImage(o.sprite, ox - o.sprite.width / 2, oy - o.sprite.height / 2);
      }
      ctx.globalAlpha = 1;
      ctx.globalCompositeOperation = 'source-over';

      if (running) raf = requestAnimationFrame(frame);
    }

    function start() {
      if (running || reduced) return;
      running = true;
      raf = requestAnimationFrame(frame);
    }
    function stop() {
      running = false;
      cancelAnimationFrame(raf);
    }

    window.addEventListener('resize', resize, { passive: true });
    window.addEventListener('mousemove', (e) => {
      tmx = (e.clientX / window.innerWidth - 0.5) * 2;
      tmy = (e.clientY / window.innerHeight - 0.5) * 2;
    }, { passive: true });

    let inView = false;
    const update = () => { (inView && !document.hidden) ? start() : stop(); };
    new IntersectionObserver((entries) => {
      inView = entries[0].isIntersecting;
      update();
    }, { rootMargin: '80px' }).observe(parent);
    document.addEventListener('visibilitychange', update);

    resize();
    if (reduced) frame();
  }
</script>
