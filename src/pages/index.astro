---
import Base from '../layouts/Base.astro';
import Globe from '../components/Globe.astro';
import { SITE } from '../site.config';
import { projects, repoTotal } from '../data/projects';
import { getCollection } from 'astro:content';

const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const notes = allNotes
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.recentCount);

const fmt = (d: Date) =>
  `${d.getFullYear()} 年 ${d.getMonth() + 1} 月 ${d.getDate()} 日`;
---

<Base>
  <!-- ================= Hero：全视口点阵地球 ================= -->
  <section class="hero">
    <Globe />
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="mono-meta" style="margin-bottom: 1.5rem;">Personal Site — 主站</p>
        <h1 style="font-family: var(--serif); font-weight: 400; font-size: clamp(2.6rem, 5.5vw, 4.6rem); line-height: 1.12; letter-spacing: -0.02em;">
          你好，我是 <em style="font-style: italic;">Kaiser</em>。
        </h1>
        <p style="margin-top: 1.5rem; font-size: var(--fs-lead); color: var(--ink-60); max-width: 24em;">
          学点新东西，写点笔记，也捣鼓点小项目。这个站是它们的集合地。
        </p>
        <nav class="entry-list" aria-label="站点入口">
          <a class="entry" href="/notes/">
            <span class="entry-no mono-meta">01</span>
            <span class="entry-title">笔记</span>
            <span class="entry-sub">学习笔记与长文</span>
            <svg class="card-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
          </a>
          <a class="entry" href="/projects/">
            <span class="entry-no mono-meta">02</span>
            <span class="entry-title">项目</span>
            <span class="entry-sub">开源代码与实现</span>
            <svg class="card-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
          </a>
          <a class="entry" href="#about">
            <span class="entry-no mono-meta">03</span>
            <span class="entry-title">关于</span>
            <span class="entry-sub">我是谁、怎么联系</span>
            <svg class="card-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
          </a>
        </nav>
        <p class="mono-meta hero-scroll" aria-hidden="true">↓ 下滑 — 最近更新 / 项目 / 关于</p>
      </div>
    </div>
  </section>

  <!-- ================= 最近更新 ================= -->
  <section class="wrap" style="padding-bottom: clamp(3rem, 7vw, 5rem);">
    <div class="section-head">
      <span class="mono-meta">Recent — 最近更新</span>
      <h2>新写的笔记</h2>
    </div>
    {notes.map((note, i) => (
      <a class="index-row" href={`/notes/${note.id}/`}>
        <span class="row-no">{String(i + 1).padStart(2, '0')}</span>
        <span>
          <span class="row-title uline">{note.data.title}</span>
          {note.data.description && <p class="row-sub">{note.data.description}</p>}
        </span>
        <span class="row-meta">{fmt(note.data.date)}</span>
      </a>
    ))}
    <p style="margin-top: 1.25rem;">
      <a class="uline mono-meta" href="/notes/" style="text-transform: none; letter-spacing: 0.06em;">查看全部笔记 →</a>
    </p>
  </section>

  <!-- ================= 项目展示 ================= -->
  <section class="wrap" id="projects" style="padding-bottom: clamp(3rem, 7vw, 5rem);">
    <div class="section-head">
      <span class="mono-meta">Open Source — 项目展示</span>
      <h2>写过的代码</h2>
    </div>
    <div class="card-grid">
      {projects.map((p, i) => (
        <a class="project-card" href={p.url} target="_blank" rel="noopener">
          <span class="card-top">
            <span class="mono-meta">{String(i + 1).padStart(2, '0')}</span>
            <span class="mono-meta">{p.language}</span>
          </span>
          <span class="card-name uline">{p.name}</span>
          <span class="card-desc">{p.description}</span>
          <span class="card-bottom mono-meta">
            <span>更新于 {p.updated}{p.license && ' · ' + p.license}</span>
            <svg class="card-arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17L17 7M8 7h9v9"/></svg>
          </span>
        </a>
      ))}
    </div>
    <p style="margin-top: 1.25rem;">
      <a class="uline mono-meta" href={SITE.github} target="_blank" rel="noopener" style="text-transform: none; letter-spacing: 0.06em;">GitHub 主页（全部 {repoTotal} 个仓库）→</a>
    </p>
  </section>

  <!-- ================= 关于（深底反转） ================= -->
  <section class="on-dark" id="about">
    <div class="wrap" style="position: relative; padding-top: clamp(3.5rem, 8vw, 6rem); padding-bottom: clamp(3.5rem, 8vw, 6rem);">
      <span class="mono-meta" style="position: absolute; top: 1.5rem; right: var(--gutter);">About — 关于</span>
      <blockquote style="font-family: var(--serif); font-weight: 400; font-size: clamp(1.5rem, 3.2vw, 2.3rem); line-height: 1.5; max-width: 22em; margin: 0;">
        我是 Kaiser，就读于南京大学。这个站是我的自留地：学到的东西记下来，手痒了就写个小项目。
      </blockquote>
      <p style="margin-top: 2rem; max-width: 36em; color: rgba(252, 252, 248, 0.65);">
        目前对机器学习系统和模型训练比较感兴趣，笔记里多半是这类内容。这里没有什么宏大的计划，更多是给自己的备忘录——如果你从中得到一点点用处，或者想聊聊，欢迎来信。
      </p>
      <div class="stats-row">
        <div class="stat">
          <span class="stat-num">{notes.length}</span>
          <span class="mono-meta stat-label">篇笔记</span>
        </div>
        <div class="stat">
          <span class="stat-num">{repoTotal}</span>
          <span class="mono-meta stat-label">个开源仓库</span>
        </div>
        <div class="stat">
          <span class="stat-num">2026</span>
          <span class="mono-meta stat-label">年建站至今</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ================= 联系 ================= -->
  <section class="on-dark" id="contact" style="border-top: 1px solid rgba(252, 252, 248, 0.12);">
    <div class="wrap" style="padding-top: clamp(3rem, 7vw, 5rem); padding-bottom: clamp(4rem, 9vw, 7rem);">
      <p class="mono-meta" style="margin-bottom: 1rem;">Contact — 联系</p>
      <p style="font-family: var(--serif); font-size: clamp(1.4rem, 3vw, 2.1rem); line-height: 1.4;">
        <a class="uline uline--dark" href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
      <p style="margin-top: 0.9rem; color: rgba(252, 252, 248, 0.55); font-size: 0.9rem;">
        邮件或 GitHub Issue 都可以，看到就会回。
      </p>
    </div>
  </section>
</Base>
