---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  const sorted = notes.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return sorted.map((note, i) => ({
    params: { id: note.id },
    props: {
      note,
      allNotes: sorted,
      prev: sorted[i - 1] ?? null,   // 更新的一篇
      next: sorted[i + 1] ?? null,   // 更早的一篇
    },
  }));
}

const { note, allNotes, prev, next } = Astro.props;
const { Content, headings: renderedHeadings } = await render(note);
const related = allNotes.filter(n => n.id !== note.id).map(n => ({ note: n, score: n.data.tags.filter(t => note.data.tags.includes(t)).length })).filter(n => n.score > 0).sort((a,b) => b.score - a.score).slice(0, 2);

const fmt = (d: Date) => `${d.getFullYear()} 年 ${d.getMonth() + 1} 月 ${d.getDate()} 日`;
const fmtShort = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}`;

// 阅读时长：中文字符按 400 字/分钟，英文单词按 250 词/分钟
const cjk = (note.body.match(/[一-鿿]/g) || []).length;
const words = (note.body.replace(/[一-鿿]/g, ' ').match(/[a-zA-Z0-9]+/g) || []).length;
const minutes = Math.max(1, Math.round(cjk / 400 + words / 250));

// Use Astro's rendered headings so links match the actual Markdown heading IDs.
const headings = renderedHeadings.filter(h => h.depth === 2 || h.depth === 3);

// 侧栏按年份分组
const yearOf = (d: Date) => d.getFullYear();
const years: { year: number; items: typeof allNotes }[] = [];
for (const n of allNotes) {
  const y = yearOf(n.data.date);
  if (!years.length || years[years.length - 1].year !== y) years.push({ year: y, items: [] });
  years[years.length - 1].items.push(n);
}
---

<Base title={`${note.data.title} · kaiser`} description={note.data.description} ogImage={`/og/note-${note.id}.png`} ogType="article" articleDate={note.data.date}>
  <div class="wrap reading-nav">
    {headings.length > 0 && <details class="reading-toc">
      <summary>本篇目录 <span>{headings.length} 个章节</span></summary>
      <nav aria-label="本篇目录" class="reading-nav-content">
        {headings.map(h => <a class:list={['toc-link', `toc-h${h.depth}`]} href={`#${h.slug}`}>{h.text}</a>)}
      </nav>
    </details>}
    <details class="reading-archive">
      <summary>其他笔记 <span>随便翻翻</span></summary>
      <nav aria-label="其他笔记" class="reading-nav-content">
        {allNotes.filter(n => n.id !== note.id).map(n => <a class="side-link" href={`/notes/${n.id}/`}>{n.data.title}</a>)}
      </nav>
    </details>
  </div>

  <div class="wrap notes-layout">
    <!-- 左栏：全部笔记 -->
    <aside class="notes-side" aria-label="全部笔记">
      <p class="mono-meta" style="margin-bottom: 1rem;">Note — 全部笔记</p>
      {years.map((g) => (
        <div class="side-group">
          <p class="mono-meta side-year">{g.year}</p>
          {g.items.map((n) => (
            <a class:list={['side-link', { active: n.id === note.id }]} href={`/notes/${n.id}/`}>
              <span class="side-title">{n.data.title}</span>
              <span class="side-date mono-meta">{fmtShort(n.data.date)}</span>
            </a>
          ))}
        </div>
      ))}
    </aside>

    <!-- 中栏：正文 -->
    <article class="prose notes-article">
      <p class="mono-meta">
        <a href="/notes/" class="uline" style="text-transform: none; letter-spacing: 0.06em;">← 返回笔记列表</a>
      </p>
      <h1>{note.data.title}</h1>
      <button class="note-ask" type="button" data-ask-note={note.id}>问小聪这篇文章 ↗</button>
      <p class="mono-meta" style="margin-bottom: 2.5rem;">
        {fmt(note.data.date)} · 约 {minutes} 分钟读完
        {note.data.tags.length > 0 && (
          <>
            {' · '}
            {note.data.tags.map((t, ti) => (
              <Fragment>
                {ti > 0 && ' '}
                <a class="tag-link" href={`/topics/${encodeURIComponent(t)}/`}>#{t}</a>
              </Fragment>
            ))}
          </>
        )}
      </p>
      <Content />

      {related.length > 0 && <aside class="related-notes" aria-label="相关阅读">
        <p class="mono-meta">沿着这个话题，再读一篇</p>
        {related.map(({note: n}) => <a href={`/notes/${n.id}/`}><strong>{n.data.title}</strong><span>{n.data.description}</span><span aria-hidden="true">↗</span></a>)}
      </aside>}
      <hr />
      <nav class="prev-next" aria-label="上一篇 / 下一篇">
        {prev ? (
          <a class="pn-link" href={`/notes/${prev.id}/`}>
            <span class="mono-meta">← 更新的一篇</span>
            <span class="pn-title uline">{prev.data.title}</span>
          </a>
        ) : <span />}
        {next ? (
          <a class="pn-link pn-right" href={`/notes/${next.id}/`}>
            <span class="mono-meta">更早的一篇 →</span>
            <span class="pn-title uline">{next.data.title}</span>
          </a>
        ) : <span />}
      </nav>
    </article>

    <!-- 右栏：本页目录 -->
    {headings.length > 0 && (
      <aside class="notes-toc" aria-label="本页目录">
        <p class="mono-meta" style="margin-bottom: 0.9rem;">On this page — 本页</p>
        {headings.map((h) => (
          <a class:list={['toc-link', `toc-h${h.depth}`]} href={`#${h.slug}`}>{h.text}</a>
        ))}
      </aside>
    )}
  </div>
  <script>
    import '../../scripts/reading';
  </script>
</Base>
