---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site.config';
import { repoTotal } from '../../data/projects';
import { getCollection } from 'astro:content';

const notes = await getCollection('notes', ({ data }) => !data.draft);
---

<Base title={`关于 · ${SITE.name}`} description="关于罗子聪">
  <!-- 顶部：与首页 Hero 一致的淡薰衣草带 -->
  <section class="about-hero">
    <div class="wrap">
      <p class="mono-meta" style="margin-bottom: 1.5rem;">About — 关于我</p>
      <h1 style="font-family: var(--serif); font-weight: 400; font-size: clamp(2.2rem, 4.5vw, 3.6rem); line-height: 1.15; letter-spacing: -0.02em;">
        你好，我是罗子聪。
      </h1>
    </div>
  </section>

  <!-- 主体：头像 + 介绍 -->
  <section class="wrap about-body">
    <div class="about-grid">
      <div class="about-side">
        <!-- 头像占位：把 avatar.jpg 放进 public/ 即自动替换显示 -->
        <div class="avatar-slot">
          <img src="/avatar.jpg" alt="罗子聪的头像" onerror="this.style.display='none'" />
          <span class="avatar-hint mono-meta">头像位置<br /><span style="text-transform: none; letter-spacing: 0.04em;">public/avatar.jpg</span></span>
        </div>
        <p class="mono-meta" style="margin-top: 1rem; text-align: center;">罗子聪 · 南京大学</p>
      </div>

      <div class="about-main">
        <div class="about-card">
          <p class="about-lead" style="margin-bottom: 0;">你好 👋，我是罗子聪 🥰</p>
          <div class="edu-badges">
            <span class="edu-badge edu-badge--whu"><span class="dot"></span>武汉大学 · 本科<span class="en">WHU</span></span>
            <span class="edu-badge edu-badge--nju"><span class="dot"></span>南京大学 · 工学 · 研0<span class="en">NJU</span></span>
          </div>
          <p>
            我会在这里记录一些学习碎片、生活琐碎，也会分享碎碎念和日常——这里没有什么宏大的计划，更多是写给自己的备忘录，也顺便写给路过的人。
          </p>
          <p>
            <span class="about-marker">这个世界我来过，我很喜欢！</span><br />
            希望早日遇见幸福呀，也希望大家都能开心幸福 😆
          </p>
        </div>

        <div class="research-card">
          <p class="mono-meta">研究方向 — Research Interests</p>
          <div class="chip-row">
            <span class="chip chip--lav">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-2.64-6.36"/><path d="M21 3v6h-6"/></svg>
              强化学习
            </span>
            <span class="chip chip--blue">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="4" y1="21" x2="4" y2="14"/><line x1="4" y1="10" x2="4" y2="3"/><line x1="12" y1="21" x2="12" y2="12"/><line x1="12" y1="8" x2="12" y2="3"/><line x1="20" y1="21" x2="20" y2="16"/><line x1="20" y1="12" x2="20" y2="3"/><line x1="1" y1="14" x2="7" y2="14"/><line x1="9" y1="8" x2="15" y2="8"/><line x1="17" y1="16" x2="23" y2="16"/></svg>
              视频码率控制
            </span>
            <span class="chip chip--orange">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="2.2"/><line x1="7" y1="2" x2="7" y2="22"/><line x1="17" y1="2" x2="17" y2="22"/><line x1="2" y1="12" x2="22" y2="12"/></svg>
              视频编码
            </span>
          </div>
        </div>

        <div class="stats-row stats-row--light">
          <div class="stat">
            <span class="stat-num">{notes.length}</span>
            <span class="mono-meta stat-label">篇笔记</span>
          </div>
          <div class="stat">
            <span class="stat-num">{repoTotal}</span>
            <span class="mono-meta stat-label">个开源仓库</span>
          </div>
          <div class="stat">
            <span class="stat-num">2026</span>
            <span class="mono-meta stat-label">年建站至今</span>
          </div>
        </div>

        <div class="about-contact" id="contact">
          <p class="mono-meta" style="margin-bottom: 0.75rem;">Contact — 联系</p>
          <p style="font-family: var(--serif); font-size: clamp(1.2rem, 2.4vw, 1.7rem); line-height: 1.4;">
            <a class="uline" href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </p>
          <p style="margin-top: 0.6rem; font-size: 0.9rem; color: var(--ink-60);">
            邮件或 GitHub Issue 都可以，看到就会回。
          </p>
          <p style="margin-top: 1.25rem;">
            <a class="uline mono-meta" href={SITE.github} target="_blank" rel="noopener" style="text-transform: none; letter-spacing: 0.06em;">GitHub 主页 →</a>
          </p>
        </div>
      </div>
    </div>
  </section>
</Base>
