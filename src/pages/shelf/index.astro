---
import Base from '../../layouts/Base.astro';
import DustCanvas from '../../components/DustCanvas.astro';
import { getCollection, render } from 'astro:content';

const all = await getCollection('shelf');
const kinds = ['韩剧', '电影', '书', '音乐', '游戏', '旅行'];
const kindUnit: Record<string, string> = { 韩剧: '部', 电影: '部', 书: '本', 音乐: '首', 游戏: '场', 旅行: '座' };
const kindLabel: Record<string, string> = {
  韩剧: '未完<span class="about-marker">待续</span>',
  电影: '银幕<span class="about-marker">往事</span>',
  书: '纸上<span class="about-marker">山河</span>',
  音乐: '声生<span class="about-marker">不息</span>',
  游戏: '游戏<span class="about-marker">人间</span>',
  旅行: '步履<span class="about-marker">不停</span>',
};
const kindMarker: Record<string, string> = {
  韩剧: 'rgba(163, 148, 194, 0.38)',
  电影: 'rgba(169, 192, 220, 0.42)',
  书: 'rgba(124, 181, 144, 0.38)',
  音乐: 'rgba(240, 215, 140, 0.55)',
  游戏: 'rgba(238, 190, 122, 0.45)',
  旅行: 'rgba(233, 170, 150, 0.38)',
};
const kindTag: Record<string, string> = {
  韩剧: '未完待续',
  电影: '银幕往事',
  书: '纸上山河',
  音乐: '声生不息',
  游戏: '游戏人间',
  旅行: '步履不停',
};
const byKind = (k: string) =>
  all.filter((e) => e.data.kind === k).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) => `${d.getFullYear()} 年 ${d.getMonth() + 1} 月 ${d.getDate()} 日`;
const isNow = (s: string) => ['在看', '在听', '在玩'].includes(s);

const entries = await Promise.all(
  all.map(async (e) => ({ e, Content: (await render(e)).Content, hasBody: e.body.trim().replace(/[（(].{0,30}(待补充|还没看完|占位).{0,30}[)）]/, '').trim().length > 0 }))
);
const findEntry = (id: string) => entries.find((x) => x.e.id === id)!;
---

<Base title={`拾光 · ${'kaiser'}`} description="精神食粮架：韩剧、电影、书、音乐、游戏、旅行与碎碎念。">
  <section class="about-hero">
    <div class="wrap">
      <p class="mono-meta" style="margin-bottom: 1.5rem;">Media Shelf — 精神食粮</p>
      <h1 style="font-family: var(--serif); font-weight: 400; font-size: clamp(2.2rem, 4.5vw, 3.6rem); line-height: 1.15; letter-spacing: -0.02em;">
        精神<span class="about-marker">食粮</span>架
      </h1>
      <p style="margin-top: 1rem; color: var(--ink-60); max-width: 30em;">
        追过的剧、看过的书、循环的歌、玩过的游戏，以及每一格下面慢慢生长的碎碎念。
      </p>
    </div>
  </section>

  <div class="dust-zone">
    <DustCanvas />
    <section class="wrap" style="padding-top: clamp(2rem, 5vw, 3rem); padding-bottom: clamp(3rem, 8vw, 6rem);">

      <!-- 统计条：点击任意一格跳转到对应分区 -->
      <div class="shelf-stats">
        {kinds.map((k) => (
          <a class="shelf-stat-link" href={`#shelf-${k}`} style={`--stat: ${kindMarker[k]}`}>
            <span class="shelf-stats-num">{all.filter((e) => e.data.kind === k).length}<small>{kindUnit[k]}</small></span>
            <span class="shelf-stats-tag">{kindTag[k]}</span>
          </a>
        ))}
      </div>

      <!-- 六个分区（空格子也占位，等它慢慢长出来） -->
      {kinds.map((k, ki) => {
        const list = byKind(k);
        return (
          <div class="shelf-anchor" id={`shelf-${k}`} style="margin-top: clamp(2.5rem, 6vw, 4rem);">
            <div class="section-head">
              <span class="mono-meta">{k} — {list.length} {kindUnit[k]}</span>
              <h2 class="shelf-title" set:html={kindLabel[k]} style={`--marker: ${kindMarker[k]}; --mdelay: ${0.15 + ki * 0.14}s`} />
            </div>
            {list.length === 0 ? (
              <p class="shelf-empty" style="margin-top: 1.2rem;">这一格还空着 —— 等它慢慢长出来……</p>
            ) : (
            <div class:list={['shelf-grid', { 'shelf-book-grid': k === '书', 'shelf-song-grid': k === '音乐' }]}>
              {list.map((e) => {
                const { Content, hasBody } = findEntry(e.id);
                if (e.data.kind === '音乐') return (
                  <article class="shelf-card shelf-song" id={e.id}>
                    <div class="song-disc">
                      <div class="song-vinyl" aria-hidden="true"><span class="song-vinyl-label"></span></div>
                      <img class="song-cover" src={e.data.images[0]} alt={`《${e.data.title}》专辑封面`} loading="lazy" decoding="async" />
                    </div>
                    <div class="song-info">
                      <div class="shelf-book-head">
                        <h3>《{e.data.title}》</h3>
                        {e.data.alt && <span class="shelf-alt">{e.data.alt}</span>}
                        <span class="shelf-headmeta">
                          <span class:list={['shelf-chip', { now: isNow(e.data.status) }]}>
                            <span class="dot"></span>{e.data.status}
                          </span>
                        </span>
                      </div>
                      <blockquote class="shelf-book-quote shelf-song-quote">
                        <Content />
                      </blockquote>
                      {e.data.link && (
                        <p style="margin-top: 0.8rem;">
                          <a class="shelf-play-btn" href={e.data.link} target="_blank" rel="noopener">▶ 去网易云听</a>
                        </p>
                      )}
                    </div>
                  </article>
                );
                if (e.data.kind === '书') return (
                  <article class="shelf-card shelf-book" id={e.id}>
                    <div class="shelf-book-cover">
                      <img src={e.data.images[0]} alt={`《${e.data.title}》封面`} loading="lazy" decoding="async" />
                    </div>
                    <div class="shelf-book-info">
                      <div class="shelf-book-head">
                        <h3>《{e.data.title}》</h3>
                        {e.data.alt && <span class="shelf-alt">{e.data.alt}</span>}
                        <span class="shelf-headmeta">
                          <span class="shelf-chip"><span class="dot"></span>{e.data.status}</span>
                        </span>
                      </div>
                      <blockquote class="shelf-book-quote">
                        <Content />
                      </blockquote>
                    </div>
                  </article>
                );
                return (
                  <article class="shelf-card" data-kind={e.data.kind} id={e.id}>
                    {e.data.images.length > 0 && (
                      <div
                        class:list={['shelf-media', { 'shelf-poster': e.data.kind === '电影', 'has-gallery': e.data.images.length > 1 }]}
                        style={e.data.kind === '电影' ? `background-image:url('${e.data.images[0]}')` : undefined}
                        data-gallery={e.data.images.length > 1 ? JSON.stringify(e.data.images) : undefined}
                        data-title={e.data.images.length > 1 ? `《${e.data.title}》` : undefined}
                      >
                        {e.data.images.length > 1 && (
                          <span class="shelf-stack" aria-hidden="true">
                            <span class="stk stk-1" style={`background-image:url('${e.data.images[1 % e.data.images.length]}')`}></span>
                            <span class="stk stk-2" style={`background-image:url('${e.data.images[2 % e.data.images.length]}')`}></span>
                          </span>
                        )}
                        <img class:list={['stk-front', { 'in-stack': e.data.images.length > 1 }]} src={e.data.images[0]} alt={`《${e.data.title}》截图`} loading="lazy" decoding="async" />
                        {e.data.images.length > 1 && (
                          <span class="shelf-media-badge">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.2"/><circle cx="8.5" cy="10" r="1.2"/><path d="m3.5 16.5 4.8-4.2 3.7 3.1 4.2-3.6 4.3 3.6"/></svg>
                            共 {e.data.images.length} 张 · 点击查看
                          </span>
                        )}
                      </div>
                    )}
                    <div class="shelf-body">
                      <div class="shelf-head">
                        <h3>
                          {e.data.kind === '旅行' ? (
                            <a class="uline" href={`/shelf/${e.id}/`}>《{e.data.title}》</a>
                          ) : (
                            <>《{e.data.title}》</>
                          )}
                          {e.data.alt && <span class="shelf-alt">/ {e.data.alt}</span>}
                        </h3>
                        <span class="shelf-headmeta">
                          <span class:list={['shelf-chip', { now: isNow(e.data.status) }]}>
                            <span class="dot"></span>{e.data.status}
                          </span>
                        </span>
                      </div>
                      <p class="mono-meta" style="margin-top: 0.35rem;">
                        {e.data.rating > 0 && (
                          <>
                            <span class="shelf-stars-wrap" title={`${e.data.rating}/10`}>
                              <span class="shelf-stars-base">★★★★★</span>
                              <span class="shelf-stars-fill" data-fill={String(e.data.rating * 10)}>★★★★★</span>
                            </span>
                            <span class="shelf-stars-num">{e.data.rating}/10</span>
                            {' · '}
                          </>
                        )}
                        收录于 {fmt(e.data.date)}
                        {e.data.hours > 0 && (
                          <>
                            {' · '}
                            时长 {e.data.hours} h
                          </>
                        )}
                        {e.data.link && (
                          <>
                            {' · '}
                            {e.data.kind === '音乐' ? (
                              <a class="shelf-play-btn" href={e.data.link} target="_blank" rel="noopener">▶ 去网易云听</a>
                            ) : (
                              <a class="uline" href={e.data.link} target="_blank" rel="noopener" style="text-transform: none; letter-spacing: 0.04em;">{e.data.kind === '电影' ? '豆瓣 ↗' : e.data.kind === '游戏' ? 'Steam ↗' : 'seeduck ↗'}</a>
                            )}
                          </>
                        )}
                        {e.data.seeduck && (
                          <>
                            {' · '}
                            <a class="uline" href={e.data.seeduck} target="_blank" rel="noopener" style="text-transform: none; letter-spacing: 0.04em;">seeduck ↗</a>
                          </>
                        )}
                      </p>
                      <div class="shelf-comment">
                        {e.data.kind === '旅行' ? (
                          <p class="shelf-travel-cta">
                            <a class="uline" href={`/shelf/${e.id}/`}>点开这座城：攻略 · 照片 · 感想 →</a>
                          </p>
                        ) : (
                          <>
                            <p class="mono-meta" style="margin-bottom: 0.4rem;">碎碎念</p>
                            {hasBody ? (
                              <div class="prose"><Content /></div>
                            ) : (
                              <p class="shelf-empty">（先占个位置，碎碎念慢慢长出来……）</p>
                            )}
                          </>
                        )}
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
            )}
          </div>
        );
      })}
    </section>
  </div>
  <script>
    // 图片灯箱：点击多图卡片的剧照，左右切换 / 滑动 / 方向键浏览
    (function () {
      const medias = [...document.querySelectorAll('.shelf-media[data-gallery]')];
      if (!medias.length) return;

      const lb = document.createElement('div');
      lb.className = 'shelf-lb';
      lb.setAttribute('role', 'dialog');
      lb.setAttribute('aria-label', '图片浏览');
      lb.innerHTML =
        '<button class="shelf-lb-close" aria-label="关闭">×</button>' +
        '<button class="shelf-lb-nav prev" aria-label="上一张">‹</button>' +
        '<figure class="shelf-lb-stage"><img alt="" /><figcaption class="shelf-lb-cap"></figcaption></figure>' +
        '<button class="shelf-lb-nav next" aria-label="下一张">›</button>' +
        '<div class="shelf-lb-count"></div>';
      document.body.appendChild(lb);

      const img = lb.querySelector('img');
      const cap = lb.querySelector('.shelf-lb-cap');
      const count = lb.querySelector('.shelf-lb-count');
      let list: string[] = [], title = '', idx = 0;

      const render = () => {
        img.src = list[idx];
        img.alt = `${title} 第 ${idx + 1} 张`;
        cap.textContent = title;
        count.textContent = `${idx + 1} / ${list.length}`;
        lb.querySelector('.prev')!.toggleAttribute('disabled', list.length < 2);
        lb.querySelector('.next')!.toggleAttribute('disabled', list.length < 2);
      };
      const open = (imgs: string[], t: string, i: number) => {
        list = imgs; title = t; idx = i;
        render();
        lb.classList.add('open');
        document.body.style.overflow = 'hidden';
      };
      const close = () => {
        lb.classList.remove('open');
        document.body.style.overflow = '';
      };
      const step = (d: number) => { idx = (idx + d + list.length) % list.length; render(); };

      medias.forEach((m) => {
        m.addEventListener('click', () => {
          const imgs = JSON.parse(m.getAttribute('data-gallery') || '[]');
          if (imgs.length > 1) open(imgs, m.getAttribute('data-title') || '', parseInt(m.getAttribute('data-current') || '0', 10));
        });
      });
      lb.querySelector('.shelf-lb-close')!.addEventListener('click', close);
      lb.querySelector('.prev')!.addEventListener('click', (e) => { e.stopPropagation(); step(-1); });
      lb.querySelector('.next')!.addEventListener('click', (e) => { e.stopPropagation(); step(1); });
      lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
      document.addEventListener('keydown', (e) => {
        if (!lb.classList.contains('open')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') step(-1);
        if (e.key === 'ArrowRight') step(1);
      });
      // 触屏滑动
      let sx = 0, sy = 0;
      lb.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
      lb.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - sx;
        const dy = e.changedTouches[0].clientY - sy;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) step(dx < 0 ? 1 : -1);
      }, { passive: true });
    })();

    // 堆叠剧照轮播：底衬两张错位剧照，顶图每 3.6s 淡换下一张（悬停/开灯时暂停）
    (function () {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      document.querySelectorAll('.shelf-media.has-gallery').forEach((m) => {
        const imgs = JSON.parse(m.getAttribute('data-gallery') || '[]');
        if (imgs.length < 2) return;
        const front = m.querySelector('.stk-front');
        if (!front) return;
        let i = 0, timer: number | null = null;
        const swap = () => {
          front.classList.add('swap');
          window.setTimeout(() => {
            i = (i + 1) % imgs.length;
            front.src = imgs[i];
            m.setAttribute('data-current', String(i));
            window.setTimeout(() => front.classList.remove('swap'), 60);
          }, 380);
        };
        const start = () => { if (timer === null) timer = window.setInterval(swap, 3600); };
        const stop = () => { if (timer !== null) { window.clearInterval(timer); timer = null; } };
        start();
        m.addEventListener('mouseenter', stop);
        m.addEventListener('mouseleave', start);
        m.addEventListener('click', stop);
        document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else start(); });
      });
    })();
  </script>
</Base>
