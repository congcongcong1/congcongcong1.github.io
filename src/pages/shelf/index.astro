---
import Base from '../../layouts/Base.astro';
import DustCanvas from '../../components/DustCanvas.astro';
import { getCollection, render } from 'astro:content';

const all = await getCollection('shelf');
const kinds = ['韩剧', '电影', '书', '音乐', '游戏', '旅行'];
const kindUnit: Record<string, string> = { 韩剧: '部', 电影: '部', 书: '本', 音乐: '首', 游戏: '场', 旅行: '座' };
const kindLabel: Record<string, string> = {
  韩剧: '未完<span class="about-marker">待续</span>',
  电影: '银幕<span class="about-marker">往事</span>',
  书: '纸上<span class="about-marker">山河</span>',
  音乐: '声生<span class="about-marker">不息</span>',
  游戏: '游戏<span class="about-marker">人间</span>',
  旅行: '步履<span class="about-marker">不停</span>',
};
const kindMarker: Record<string, string> = {
  韩剧: 'rgba(163, 148, 194, 0.38)',
  电影: 'rgba(169, 192, 220, 0.42)',
  书: 'rgba(124, 181, 144, 0.38)',
  音乐: 'rgba(240, 215, 140, 0.55)',
  游戏: 'rgba(238, 190, 122, 0.45)',
  旅行: 'rgba(233, 170, 150, 0.38)',
};
const kindTag: Record<string, string> = {
  韩剧: '未完待续',
  电影: '银幕往事',
  书: '纸上山河',
  音乐: '声生不息',
  游戏: '游戏人间',
  旅行: '步履不停',
};
const byKind = (k: string) =>
  all.filter((e) => e.data.kind === k).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) => `${d.getFullYear()} 年 ${d.getMonth() + 1} 月 ${d.getDate()} 日`;
const isNow = (s: string) => ['在看', '在听', '在玩'].includes(s);

const entries = await Promise.all(
  all.map(async (e) => ({ e, Content: (await render(e)).Content, hasBody: e.body.trim().replace(/[（(].{0,30}(待补充|还没看完|占位).{0,30}[)）]/, '').trim().length > 0 }))
);
const findEntry = (id: string) => entries.find((x) => x.e.id === id)!;

// 「今晚看点啥」放映机奖池：排除「旅行」（15 座城是游记占位，不适合摇）。
// line = 金句第一条，否则正文去 markdown 后截 80 字
const plain = (s: string) =>
  s.replace(/!\[[^\]]*\]\([^)]*\)/g, ' ').replace(/\[[^\]]*\]\([^)]*\)/g, ' ').replace(/[`*#>|\[\]()-]/g, ' ').replace(/\s+/g, ' ').trim();
const slotPool = entries
  .filter((x) => x.e.data.kind !== '旅行')
  .map((x) => ({
    id: x.e.id,
    kind: x.e.data.kind,
    title: x.e.data.title,
    alt: x.e.data.alt,
    rating: x.e.data.rating,
    status: x.e.data.status,
    image: x.e.data.images[0] || '',
    url: `/shelf/${x.e.id}/`,
    line: x.e.data.quotes[0] || plain(x.e.body).slice(0, 80),
  }));
---

<Base title={`拾光 · ${'kaiser'}`} description="精神食粮架：韩剧、电影、书、音乐、游戏、旅行与碎碎念。">
  <section class="about-hero">
    <div class="wrap">
      <p class="mono-meta" style="margin-bottom: 1.5rem;">Media Shelf — 精神食粮</p>
      <h1 style="font-family: var(--serif); font-weight: 400; font-size: clamp(2.2rem, 4.5vw, 3.6rem); line-height: 1.15; letter-spacing: -0.02em;">
        精神<span class="about-marker">食粮</span>架
      </h1>
      <p style="margin-top: 1rem; color: var(--ink-60); max-width: 30em;">
        追过的剧、看过的书、循环的歌、玩过的游戏，以及每一格下面慢慢生长的碎碎念。
      </p>
      <p style="margin-top: 1.3rem;">
        <button class="slot-btn" id="slot-btn" type="button">🎰 今晚看点啥？让架子替你决定</button>
      </p>
    </div>
  </section>

  <div class="dust-zone">
    <DustCanvas />
    <section class="wrap" style="padding-top: clamp(2rem, 5vw, 3rem); padding-bottom: clamp(3rem, 8vw, 6rem);">

      <!-- 统计条：点击任意一格跳转到对应分区 -->
      <div class="shelf-stats">
        {kinds.map((k) => (
          <a class="shelf-stat-link" href={`#shelf-${k}`} style={`--stat: ${kindMarker[k]}`}>
            <span class="shelf-stats-num">{all.filter((e) => e.data.kind === k).length}<small>{kindUnit[k]}</small></span>
            <span class="shelf-stats-tag">{kindTag[k]}</span>
          </a>
        ))}
      </div>

      <!-- 六个分区（空格子也占位，等它慢慢长出来） -->
      {kinds.map((k, ki) => {
        const list = byKind(k);
        return (
          <div class="shelf-anchor" id={`shelf-${k}`} style="margin-top: clamp(2.5rem, 6vw, 4rem);">
            <div class="section-head">
              <span class="mono-meta">{k} — {list.length} {kindUnit[k]}</span>
              <h2 class="shelf-title" set:html={kindLabel[k]} style={`--marker: ${kindMarker[k]}; --mdelay: ${0.15 + ki * 0.14}s`} />
            </div>
            {list.length === 0 ? (
              <p class="shelf-empty" style="margin-top: 1.2rem;">这一格还空着 —— 等它慢慢长出来……</p>
            ) : (
            <div class:list={['shelf-grid', { 'shelf-book-grid': k === '书', 'shelf-song-grid': k === '音乐' }]}>
              {list.map((e) => {
                const { Content, hasBody } = findEntry(e.id);
                if (e.data.kind === '音乐') return (
                  <article class="shelf-card shelf-song" id={e.id}>
                    <div class="song-disc">
                      <div class="song-vinyl" aria-hidden="true"><span class="song-vinyl-label"></span></div>
                      <img class="song-cover" src={e.data.images[0]} alt={`《${e.data.title}》专辑封面`} loading="lazy" decoding="async" />
                    </div>
                    <div class="song-info">
                      <div class="shelf-book-head">
                        <h3><a class="uline" href={`/shelf/${e.id}/`}>《{e.data.title}》</a></h3>
                        {e.data.alt && <span class="shelf-alt">{e.data.alt}</span>}
                        <span class="shelf-headmeta">
                          <span class:list={['shelf-chip', { now: isNow(e.data.status) }]}>
                            <span class="dot"></span>{e.data.status}
                          </span>
                        </span>
                      </div>
                      <blockquote class="shelf-book-quote shelf-song-quote">
                        <Content />
                      </blockquote>
                      {e.data.link && (
                        <p style="margin-top: 0.8rem;">
                          <a class="shelf-play-btn" href={e.data.link} target="_blank" rel="noopener">▶ 去网易云听</a>
                        </p>
                      )}
                    </div>
                  </article>
                );
                if (e.data.kind === '书') return (
                  <article class="shelf-card shelf-book" id={e.id}>
                    <div class="shelf-book-cover">
                      <img src={e.data.images[0]} alt={`《${e.data.title}》封面`} loading="lazy" decoding="async" />
                    </div>
                    <div class="shelf-book-info">
                      <div class="shelf-book-head">
                        <h3><a class="uline" href={`/shelf/${e.id}/`}>《{e.data.title}》</a></h3>
                        {e.data.alt && <span class="shelf-alt">{e.data.alt}</span>}
                        <span class="shelf-headmeta">
                          <span class="shelf-chip"><span class="dot"></span>{e.data.status}</span>
                        </span>
                      </div>
                      <blockquote class="shelf-book-quote">
                        <Content />
                      </blockquote>
                    </div>
                  </article>
                );
                return (
                  <article class="shelf-card" data-kind={e.data.kind} id={e.id}>
                    {e.data.images.length > 0 && (
                      <div
                        class:list={['shelf-media', { 'shelf-poster': e.data.kind === '电影', 'has-gallery': e.data.images.length > 1 }]}
                        style={e.data.kind === '电影' ? `background-image:url('${e.data.images[0]}')` : undefined}
                        data-gallery={e.data.images.length > 1 ? JSON.stringify(e.data.images) : undefined}
                        data-title={e.data.images.length > 1 ? `《${e.data.title}》` : undefined}
                      >
                        {e.data.images.length > 1 && (
                          <span class="shelf-stack" aria-hidden="true">
                            <span class="stk stk-1" style={`background-image:url('${e.data.images[1 % e.data.images.length]}')`}></span>
                            <span class="stk stk-2" style={`background-image:url('${e.data.images[2 % e.data.images.length]}')`}></span>
                          </span>
                        )}
                        <img class:list={['stk-front', { 'in-stack': e.data.images.length > 1 }]} src={e.data.images[0]} alt={`《${e.data.title}》截图`} loading="lazy" decoding="async" />
                        {e.data.images.length > 1 && (
                          <span class="shelf-media-badge">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.2"/><circle cx="8.5" cy="10" r="1.2"/><path d="m3.5 16.5 4.8-4.2 3.7 3.1 4.2-3.6 4.3 3.6"/></svg>
                            共 {e.data.images.length} 张 · 点击查看
                          </span>
                        )}
                      </div>
                    )}
                    <div class="shelf-body">
                      <div class="shelf-head">
                        <h3>
                          <a class="uline" href={`/shelf/${e.id}/`}>《{e.data.title}》</a>
                          {e.data.alt && <span class="shelf-alt">/ {e.data.alt}</span>}
                        </h3>
                        <span class="shelf-headmeta">
                          <span class:list={['shelf-chip', { now: isNow(e.data.status) }]}>
                            <span class="dot"></span>{e.data.status}
                          </span>
                        </span>
                      </div>
                      <p class="mono-meta" style="margin-top: 0.35rem;">
                        {e.data.rating > 0 && (
                          <>
                            <span class="shelf-stars-wrap" title={`${e.data.rating}/10`}>
                              <span class="shelf-stars-base">★★★★★</span>
                              <span class="shelf-stars-fill" data-fill={String(e.data.rating * 10)}>★★★★★</span>
                            </span>
                            <span class="shelf-stars-num">{e.data.rating}/10</span>
                            {' · '}
                          </>
                        )}
                        收录于 {fmt(e.data.date)}
                        {e.data.hours > 0 && (
                          <>
                            {' · '}
                            时长 {e.data.hours} h
                          </>
                        )}
                        {e.data.link && (
                          <>
                            {' · '}
                            {e.data.kind === '音乐' ? (
                              <a class="shelf-play-btn" href={e.data.link} target="_blank" rel="noopener">▶ 去网易云听</a>
                            ) : (
                              <a class="uline" href={e.data.link} target="_blank" rel="noopener" style="text-transform: none; letter-spacing: 0.04em;">{e.data.kind === '电影' ? '豆瓣 ↗' : e.data.kind === '游戏' ? 'Steam ↗' : 'seeduck ↗'}</a>
                            )}
                          </>
                        )}
                        {e.data.seeduck && (
                          <>
                            {' · '}
                            <a class="uline" href={e.data.seeduck} target="_blank" rel="noopener" style="text-transform: none; letter-spacing: 0.04em;">seeduck ↗</a>
                          </>
                        )}
                      </p>
                      <div class="shelf-comment">
                        {e.data.kind === '韩剧' ? (
                          <>
                            {e.data.quotes.length > 0 ? (
                              <>
                                <p class="mono-meta" style="margin-bottom: 0.4rem;">金句摘抄</p>
                                <div class="prose shelf-quotes">
                                  <ol>
                                    {e.data.quotes.map((q) => <li>{q}</li>)}
                                  </ol>
                                </div>
                              </>
                            ) : hasBody ? (
                              <div class="prose"><Content /></div>
                            ) : (
                              <p class="shelf-empty">（先占个位置，碎碎念慢慢长出来……）</p>
                            )}
                            {hasBody && (
                              <p class="shelf-travel-cta" style="margin-top: 0.7rem;">
                                <a class="uline" href={`/shelf/${e.id}/`}>观后感全文 →</a>
                              </p>
                            )}
                          </>
                        ) : e.data.kind === '旅行' ? (
                          <p class="shelf-travel-cta">
                            <a class="uline" href={`/shelf/${e.id}/`}>点开这座城：攻略 · 照片 · 感想 →</a>
                          </p>
                        ) : (
                          <>
                            <p class="mono-meta" style="margin-bottom: 0.4rem;">碎碎念</p>
                            {hasBody ? (
                              <>
                                <div class="prose"><Content /></div>
                                <p class="shelf-travel-cta" style="margin-top: 0.7rem;">
                                  <a class="uline" href={`/shelf/${e.id}/`}>全文 →</a>
                                </p>
                              </>
                            ) : (
                              <p class="shelf-empty">（先占个位置，碎碎念慢慢长出来……）</p>
                            )}
                          </>
                        )}
                      </div>
                    </div>
                  </article>
                );
              })}
            </div>
            )}
          </div>
        );
      })}
    </section>
  </div>

  <!-- 「今晚看点啥」放映机：雪花屏 → 抽出一张拍立得 -->
  <div class="slot-overlay" id="slot-overlay" hidden>
    <div class="slot-stage">
      <div class="slot-card" id="slot-card">
        <canvas class="slot-noise" id="slot-noise" width="96" height="64" hidden></canvas>
        <div class="slot-face" id="slot-face" hidden>
          <img id="slot-img" alt="" loading="lazy" />
          <div class="slot-cap">
            <span class="slot-kind mono-meta" id="slot-kind"></span>
            <h3 id="slot-title"></h3>
            <p class="slot-line" id="slot-line"></p>
            <p class="slot-meta" id="slot-meta"></p>
          </div>
        </div>
      </div>
      <div class="slot-actions">
        <button class="slot-act" id="slot-again" type="button">🔁 换一个</button>
        <a class="slot-act slot-go" id="slot-go" href="#">就它了 →</a>
        <button class="slot-act slot-x" id="slot-close" type="button" aria-label="关闭">×</button>
      </div>
    </div>
  </div>

  <style>
    .slot-btn {
      font: inherit; font-size: 0.88rem; padding: 0.5rem 1.3rem; cursor: pointer;
      background: var(--ink); color: var(--paper); border: 0; border-radius: 99px;
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .slot-btn:hover { transform: translateY(-2px) rotate(-1.5deg); }
    .slot-overlay {
      position: fixed; inset: 0; z-index: 80; display: flex; align-items: center; justify-content: center;
      padding: 1rem; box-sizing: border-box;
      background: rgba(26, 16, 38, 0.55);
      backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px);
    }
    .slot-overlay[hidden] { display: none; }
    .slot-stage {
      display: flex; flex-direction: column; align-items: center; gap: 1.1rem; padding: 0.5rem;
      margin: auto; max-height: 100%; overflow-y: auto;
    }
    .slot-card {
      width: min(300px, 82vw); background: var(--paper); border-radius: 8px;
      padding: 12px 12px 16px; transform: rotate(-1.6deg);
      border: 1.5px solid var(--ink-10);
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.45);
      animation: slot-in 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    @keyframes slot-in { from { opacity: 0; transform: rotate(-6deg) translateY(30px) scale(0.8); } }
    .slot-card.rolling { animation: slot-shake 0.12s linear infinite; }
    @keyframes slot-shake {
      0%, 100% { transform: rotate(-1.6deg) translate(0, 0); }
      25% { transform: rotate(-2.6deg) translate(-2px, 1px); }
      75% { transform: rotate(-0.6deg) translate(2px, -1px); }
    }
    .slot-noise { display: block; width: 100%; aspect-ratio: 3 / 4; border-radius: 3px; background: #111; image-rendering: pixelated; }
    .slot-noise[hidden], .slot-face[hidden] { display: none; }
    .slot-face.reveal { animation: slot-flip 0.5s ease; }
    @keyframes slot-flip { from { opacity: 0; transform: perspective(600px) rotateY(70deg); } }
    .slot-face img { display: block; width: 100%; max-height: 46vh; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 3px; background: var(--paper-sunken); }
    .slot-cap { padding: 0.7rem 0.2rem 0; }
    .slot-kind { color: var(--ink-60); }
    .slot-cap h3 { font-family: var(--serif); font-weight: 400; font-size: 1.15rem; margin: 0.25rem 0 0.2rem; }
    .slot-line {
      font-size: 0.8rem; color: var(--ink-80); line-height: 1.6; margin: 0 0 0.4rem;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .slot-meta { font-size: 0.72rem; color: var(--ink-60); margin: 0; letter-spacing: 0.06em; }
    .slot-actions { display: flex; gap: 0.6rem; align-items: center; }
    .slot-act {
      font: inherit; font-size: 0.85rem; padding: 0.45rem 1.1rem; border-radius: 99px; cursor: pointer;
      background: var(--paper); color: var(--ink); border: 1.5px solid var(--ink-20); text-decoration: none;
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .slot-act:hover { transform: translateY(-2px); }
    .slot-go { background: var(--ink); color: var(--paper); border-color: var(--ink); }
    .slot-x { padding: 0.45rem 0.85rem; }
  </style>
  <script define:vars={{ slotPool }}>
    // 「今晚看点啥」：雪花屏 0.95s → 抽出一张拍立得（奖池由 frontmatter 注入）
    (function () {
      const btn = document.getElementById('slot-btn');
      const overlay = document.getElementById('slot-overlay');
      const card = document.getElementById('slot-card');
      const face = document.getElementById('slot-face');
      const noise = document.getElementById('slot-noise');
      const img = document.getElementById('slot-img');
      const kindEl = document.getElementById('slot-kind');
      const titleEl = document.getElementById('slot-title');
      const lineEl = document.getElementById('slot-line');
      const metaEl = document.getElementById('slot-meta');
      const go = document.getElementById('slot-go');
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let noiseTimer = 0;

      function noiseFrame() {
        const x = noise.getContext('2d');
        const d = x.createImageData(96, 64);
        for (let i = 0; i < d.data.length; i += 4) {
          const v = (Math.random() * 255) | 0;
          d.data[i] = d.data[i + 1] = d.data[i + 2] = v;
          d.data[i + 3] = 255;
        }
        x.putImageData(d, 0, 0);
      }
      function startNoise() {
        face.hidden = true;
        noise.hidden = false;
        noiseFrame();
        noiseTimer = window.setInterval(noiseFrame, 90);
        card.classList.add('rolling');
      }
      function stopNoise() {
        window.clearInterval(noiseTimer);
        noiseTimer = 0;
        card.classList.remove('rolling');
      }
      function starsOf(r) {
        const n = Math.round(r / 2);
        return '★★★★★'.slice(0, n) + '☆☆☆☆☆'.slice(0, 5 - n);
      }
      function roll() {
        if (noiseTimer || !slotPool.length) return;
        startNoise();
        window.setTimeout(() => {
          const it = slotPool[Math.floor(Math.random() * slotPool.length)];
          stopNoise();
          img.src = it.image;
          img.alt = `《${it.title}》封面`;
          kindEl.textContent = `${it.kind} · ${it.status}`;
          titleEl.textContent = it.alt ? `${it.title} / ${it.alt}` : it.title;
          lineEl.textContent = it.line || '（还没写碎碎念，先去详情页坐坐）';
          metaEl.textContent = it.rating > 0 ? `${starsOf(it.rating)} ${it.rating}/10` : '';
          go.href = it.url;
          noise.hidden = true;
          face.hidden = false;
          face.classList.remove('reveal');
          void face.offsetWidth;
          face.classList.add('reveal');
        }, reduced ? 60 : 950);
      }
      function open() {
        overlay.hidden = false;
        document.body.style.overflow = 'hidden';
        roll();
      }
      function close() {
        overlay.hidden = true;
        document.body.style.overflow = '';
        stopNoise();
      }
      btn.addEventListener('click', open);
      document.getElementById('slot-again').addEventListener('click', roll);
      document.getElementById('slot-close').addEventListener('click', close);
      overlay.addEventListener('click', (e) => { if (e.target === overlay) close(); });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !overlay.hidden) close();
      });
    })();
  </script>
  <script>
    // 图片灯箱：点击多图卡片的剧照，左右切换 / 滑动 / 方向键浏览
    (function () {
      const medias = [...document.querySelectorAll('.shelf-media[data-gallery]')];
      if (!medias.length) return;

      const lb = document.createElement('div');
      lb.className = 'shelf-lb';
      lb.setAttribute('role', 'dialog');
      lb.setAttribute('aria-label', '图片浏览');
      lb.innerHTML =
        '<button class="shelf-lb-close" aria-label="关闭">×</button>' +
        '<button class="shelf-lb-nav prev" aria-label="上一张">‹</button>' +
        '<figure class="shelf-lb-stage"><img alt="" /><figcaption class="shelf-lb-cap"></figcaption></figure>' +
        '<button class="shelf-lb-nav next" aria-label="下一张">›</button>' +
        '<div class="shelf-lb-count"></div>';
      document.body.appendChild(lb);

      const img = lb.querySelector('img');
      const cap = lb.querySelector('.shelf-lb-cap');
      const count = lb.querySelector('.shelf-lb-count');
      let list: string[] = [], title = '', idx = 0;

      const render = () => {
        img.src = list[idx];
        img.alt = `${title} 第 ${idx + 1} 张`;
        cap.textContent = title;
        count.textContent = `${idx + 1} / ${list.length}`;
        lb.querySelector('.prev')!.toggleAttribute('disabled', list.length < 2);
        lb.querySelector('.next')!.toggleAttribute('disabled', list.length < 2);
      };
      const open = (imgs: string[], t: string, i: number) => {
        list = imgs; title = t; idx = i;
        render();
        lb.classList.add('open');
        document.body.style.overflow = 'hidden';
      };
      const close = () => {
        lb.classList.remove('open');
        document.body.style.overflow = '';
      };
      const step = (d: number) => { idx = (idx + d + list.length) % list.length; render(); };

      medias.forEach((m) => {
        m.addEventListener('click', () => {
          const imgs = JSON.parse(m.getAttribute('data-gallery') || '[]');
          if (imgs.length > 1) open(imgs, m.getAttribute('data-title') || '', parseInt(m.getAttribute('data-current') || '0', 10));
        });
      });
      lb.querySelector('.shelf-lb-close')!.addEventListener('click', close);
      lb.querySelector('.prev')!.addEventListener('click', (e) => { e.stopPropagation(); step(-1); });
      lb.querySelector('.next')!.addEventListener('click', (e) => { e.stopPropagation(); step(1); });
      lb.addEventListener('click', (e) => { if (e.target === lb) close(); });
      document.addEventListener('keydown', (e) => {
        if (!lb.classList.contains('open')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') step(-1);
        if (e.key === 'ArrowRight') step(1);
      });
      // 触屏滑动
      let sx = 0, sy = 0;
      lb.addEventListener('touchstart', (e) => { sx = e.touches[0].clientX; sy = e.touches[0].clientY; }, { passive: true });
      lb.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - sx;
        const dy = e.changedTouches[0].clientY - sy;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) step(dx < 0 ? 1 : -1);
      }, { passive: true });
    })();

    // 堆叠剧照轮播：底衬两张错位剧照，顶图每 3.6s 淡换下一张（悬停/开灯时暂停）
    (function () {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      document.querySelectorAll('.shelf-media.has-gallery').forEach((m) => {
        const imgs = JSON.parse(m.getAttribute('data-gallery') || '[]');
        if (imgs.length < 2) return;
        const front = m.querySelector('.stk-front');
        if (!front) return;
        let i = 0, timer: number | null = null;
        const swap = () => {
          front.classList.add('swap');
          window.setTimeout(() => {
            i = (i + 1) % imgs.length;
            front.src = imgs[i];
            m.setAttribute('data-current', String(i));
            window.setTimeout(() => front.classList.remove('swap'), 60);
          }, 380);
        };
        const start = () => { if (timer === null) timer = window.setInterval(swap, 3600); };
        const stop = () => { if (timer !== null) { window.clearInterval(timer); timer = null; } };
        start();
        m.addEventListener('mouseenter', stop);
        m.addEventListener('mouseleave', start);
        m.addEventListener('click', stop);
        document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); else start(); });
      });
    })();
  </script>
</Base>
